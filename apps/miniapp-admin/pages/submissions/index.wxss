.filter-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 4rpx 0;
}

.filter-chip {
  flex: 0 0 auto;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #57708f;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  font-size: 24rpx;
  font-weight: 760;
}

.filter-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
}

.submission-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.submission-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.08);
}

.submission-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.submission-title {
  flex: 1;
  color: #08203d;
  font-size: 30rpx;
  font-weight: 860;
  line-height: 1.35;
}

.status-badge,
.type-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 820;
}

.status-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  color: #1d4ed8;
  background: rgba(29, 78, 216, 0.1);
}

.status-badge.done {
  color: #059669;
  background: rgba(16, 185, 129, 0.12);
}

.status-badge.reject {
  color: #dc2626;
  background: rgba(239, 68, 68, 0.12);
}

.type-badge {
  margin-top: 16rpx;
  padding: 8rpx 18rpx;
  color: #0f766e;
  background: rgba(20, 184, 166, 0.12);
}

.type-badge.knowledge {
  color: #b45309;
  background: rgba(245, 158, 11, 0.13);
}

.type-badge.service {
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.11);
}

.submission-desc,
.submission-meta {
  display: block;
  margin-top: 14rpx;
  color: #57708f;
  font-size: 24rpx;
  line-height: 1.55;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-btn {
  min-width: 132rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 820;
}

.action-btn::after {
  border: 0;
}

.action-btn.view {
  background: #2563eb;
}

.action-btn.approve {
  background: #059669;
}

.action-btn.reject {
  background: #f59e0b;
}

.action-btn.delete {
  background: #dc2626;
}

.action-btn.disabled {
  background: #94a3b8;
}

.empty-panel {
  text-align: left;
}
