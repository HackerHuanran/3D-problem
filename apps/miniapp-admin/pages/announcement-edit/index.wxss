.form-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-tip {
  display: block;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  color: #1d4ed8;
  background: rgba(29, 78, 216, 0.08);
  font-size: 24rpx;
  line-height: 1.6;
}

.field-label {
  display: block;
  color: #08203d;
  font-size: 25rpx;
  font-weight: 820;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 20rpx;
  padding: 0 22rpx;
  color: #08203d;
  background: rgba(29, 78, 216, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  font-size: 26rpx;
}

.input {
  height: 82rpx;
}

.textarea {
  min-height: 220rpx;
  padding-top: 20rpx;
  line-height: 1.65;
}

.announcement-textarea {
  min-height: 260rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: rgba(8, 32, 61, 0.04);
}

.switch-tip {
  display: block;
  margin-top: 8rpx;
  color: #57708f;
  font-size: 23rpx;
  line-height: 1.45;
}
