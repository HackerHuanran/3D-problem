.form-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label {
  display: block;
  color: #08203d;
  font-size: 25rpx;
  font-weight: 820;
}

.input,
.picker-field {
  box-sizing: border-box;
  width: 100%;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 20rpx;
  padding: 0 22rpx;
  color: #08203d;
  background: rgba(29, 78, 216, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  font-size: 26rpx;
}

.picker-field {
  font-weight: 760;
}

.image-picker {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(8, 32, 61, 0.04);
  border: 1rpx dashed rgba(29, 78, 216, 0.18);
}

.image-preview {
  width: 100%;
  height: 100%;
}

.image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.image-placeholder-text {
  color: #8aa0bd;
  font-size: 25rpx;
}

.inline-actions {
  display: flex;
  gap: 24rpx;
}

.text-link {
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 800;
}

.text-link.danger {
  color: #dc2626;
}
