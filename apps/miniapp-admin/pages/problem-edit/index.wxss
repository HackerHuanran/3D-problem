.form-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label,
.section-title {
  display: block;
  color: #08203d;
  font-size: 25rpx;
  font-weight: 820;
}

.section-title {
  margin-top: 18rpx;
  font-size: 29rpx;
}

.step-title {
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 860;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 20rpx;
  padding: 0 22rpx;
  color: #08203d;
  background: rgba(29, 78, 216, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  font-size: 26rpx;
}

.input {
  height: 78rpx;
}

.textarea {
  min-height: 180rpx;
  padding-top: 20rpx;
  line-height: 1.55;
}

.textarea.small {
  min-height: 132rpx;
}

.repeat-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.repeat-item.vertical {
  align-items: stretch;
  flex-direction: column;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(8, 32, 61, 0.04);
}

.flex {
  flex: 1;
}

.text-link {
  flex: 0 0 auto;
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 800;
}

.text-link.danger {
  color: #dc2626;
}

.compact {
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 0;
}

.preview-image {
  display: block;
  width: 100%;
  height: 300rpx;
  border-radius: 20rpx;
  background: rgba(8, 32, 61, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
}

.cover-preview,
.step-preview {
  margin-bottom: 4rpx;
}

.image-empty {
  box-sizing: border-box;
  width: 100%;
  height: 160rpx;
  line-height: 160rpx;
  border-radius: 20rpx;
  color: #8aa0bd;
  background: rgba(8, 32, 61, 0.04);
  border: 1rpx dashed rgba(29, 78, 216, 0.16);
  font-size: 25rpx;
  text-align: center;
}

.small-empty {
  height: 110rpx;
  line-height: 110rpx;
}

.btn-danger {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 18rpx;
  border-radius: 22rpx;
  border: 0;
  color: #ffffff;
  background: #dc2626;
  font-size: 28rpx;
  font-weight: 820;
}

.btn-danger::after {
  border: 0;
}
