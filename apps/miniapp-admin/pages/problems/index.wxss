.search-panel {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 14rpx 36rpx rgba(13, 41, 87, 0.07);
}

.search-input {
  flex: 1;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #08203d;
  background: rgba(29, 78, 216, 0.06);
  font-size: 25rpx;
}

.search-btn,
.clear-btn {
  flex: 0 0 auto;
  min-width: 112rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 820;
}

.search-btn {
  color: #ffffff;
  background: #2563eb;
}

.clear-btn {
  color: #1d4ed8;
  background: rgba(29, 78, 216, 0.08);
}

.search-btn::after,
.clear-btn::after {
  border: 0;
}

.problem-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.problem-card {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.08);
}

.problem-cover {
  flex: 0 0 auto;
  width: 168rpx;
  height: 168rpx;
  border-radius: 22rpx;
  background: rgba(8, 32, 61, 0.06);
}

.cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8aa0bd;
  font-size: 24rpx;
}

.problem-copy {
  flex: 1;
  min-width: 0;
}

.problem-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.problem-title {
  flex: 1;
  color: #08203d;
  font-size: 29rpx;
  font-weight: 860;
  line-height: 1.35;
}

.problem-badge {
  flex: 0 0 auto;
  max-width: 150rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: rgba(20, 184, 166, 0.12);
  font-size: 21rpx;
  font-weight: 820;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.problem-desc,
.problem-meta {
  display: block;
  margin-top: 10rpx;
  color: #57708f;
  font-size: 23rpx;
  line-height: 1.48;
}

.problem-desc {
  display: -webkit-box;
  overflow: hidden;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.action-btn {
  min-width: 132rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 820;
}

.action-btn::after {
  border: 0;
}

.action-btn.edit {
  background: #2563eb;
}

.action-btn.delete {
  background: #dc2626;
}

.load-more {
  padding: 12rpx 0 26rpx;
  color: #8aa0bd;
  font-size: 24rpx;
  text-align: center;
}

.empty-panel {
  text-align: left;
}
