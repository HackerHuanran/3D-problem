.goods-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.goods-card {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.08);
}

.goods-image {
  flex: 0 0 auto;
  width: 168rpx;
  height: 168rpx;
  border-radius: 22rpx;
  background: rgba(8, 32, 61, 0.06);
}

.image-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8aa0bd;
  font-size: 24rpx;
}

.goods-copy {
  flex: 1;
  min-width: 0;
}

.goods-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.goods-title {
  flex: 1;
  color: #08203d;
  font-size: 30rpx;
  font-weight: 860;
  line-height: 1.35;
}

.category-badge {
  flex: 0 0 auto;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: rgba(20, 184, 166, 0.12);
  font-size: 21rpx;
  font-weight: 820;
}

.goods-meta {
  display: block;
  margin-top: 10rpx;
  color: #57708f;
  font-size: 23rpx;
  line-height: 1.48;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.action-btn {
  min-width: 132rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 820;
}

.action-btn::after,
.add-btn::after {
  border: 0;
}

.action-btn.edit {
  background: #2563eb;
}

.action-btn.delete {
  background: #dc2626;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 8rpx 0 28rpx;
  border-radius: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
  font-size: 28rpx;
  font-weight: 860;
}

.empty-panel {
  text-align: left;
}
