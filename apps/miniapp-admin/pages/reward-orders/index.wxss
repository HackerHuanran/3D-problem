.filter-row {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding: 4rpx 0;
}

.filter-chip {
  flex: 0 0 auto;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  color: #57708f;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  font-size: 24rpx;
  font-weight: 760;
}

.filter-chip.active {
  color: #ffffff;
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.order-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.08);
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.order-title {
  flex: 1;
  color: #08203d;
  font-size: 30rpx;
  font-weight: 860;
  line-height: 1.35;
}

.status-badge {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #f59e0b;
  background: rgba(245, 158, 11, 0.12);
  font-size: 22rpx;
  font-weight: 820;
}

.status-badge.done {
  color: #059669;
  background: rgba(16, 185, 129, 0.12);
}

.status-badge.shipped {
  color: #2563eb;
  background: rgba(37, 99, 235, 0.12);
}

.order-body {
  display: flex;
  gap: 18rpx;
  margin-top: 20rpx;
}

.order-image {
  flex: 0 0 auto;
  width: 132rpx;
  height: 132rpx;
  border-radius: 22rpx;
  background: rgba(8, 32, 61, 0.06);
}

.order-image-empty::after {
  content: "";
}

.order-copy {
  flex: 1;
  min-width: 0;
}

.order-meta {
  display: block;
  color: #57708f;
  font-size: 24rpx;
  line-height: 1.55;
}

.tracking-meta {
  color: #1d4ed8;
  font-weight: 760;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 22rpx;
}

.action-btn {
  min-width: 150rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 18rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 820;
}

.action-btn::after {
  border: 0;
}

.action-btn.view {
  background: #2563eb;
}

.action-btn.approve {
  background: #059669;
}

.action-btn.ship {
  background: #f97316;
}

.action-btn.disabled {
  background: #94a3b8;
}
