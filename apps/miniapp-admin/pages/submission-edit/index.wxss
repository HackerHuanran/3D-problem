.form-panel {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-label,
.section-title {
  display: block;
  color: #08203d;
  font-size: 25rpx;
  font-weight: 820;
}

.section-title {
  margin-top: 18rpx;
  font-size: 28rpx;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border-radius: 20rpx;
  padding: 0 22rpx;
  color: #08203d;
  background: rgba(29, 78, 216, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  font-size: 26rpx;
}

.input {
  height: 78rpx;
}

.textarea {
  min-height: 180rpx;
  padding-top: 20rpx;
  line-height: 1.55;
}

.textarea.small {
  min-height: 132rpx;
}

.repeat-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.repeat-item.vertical {
  align-items: stretch;
  flex-direction: column;
  padding: 18rpx;
  border-radius: 22rpx;
  background: rgba(8, 32, 61, 0.04);
}

.inline-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.inline-actions {
  display: flex;
  gap: 24rpx;
}

.flex {
  flex: 1;
}

.text-link {
  flex: 0 0 auto;
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 800;
}

.text-link.danger {
  color: #dc2626;
}

.compact {
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 0;
}

.preview-image,
.preview-thumb {
  display: block;
  border-radius: 20rpx;
  background: rgba(8, 32, 61, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
}

.preview-image {
  width: 100%;
  height: 300rpx;
}

.cover-preview,
.step-preview {
  margin-bottom: 4rpx;
}

.qr-preview {
  width: 220rpx;
  height: 220rpx;
}

.preview-thumb {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
}

.image-empty {
  box-sizing: border-box;
  width: 100%;
  height: 160rpx;
  line-height: 160rpx;
  border-radius: 20rpx;
  color: #8aa0bd;
  background: rgba(8, 32, 61, 0.04);
  border: 1rpx dashed rgba(29, 78, 216, 0.16);
  font-size: 25rpx;
  text-align: center;
}

.block-image-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.block-image-item {
  min-width: 0;
}

.preview-block-image {
  width: 100%;
  height: 210rpx;
  border-radius: 18rpx;
  background: rgba(8, 32, 61, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
}

.image-input {
  margin-top: 10rpx;
}

.image-delete {
  display: block;
  margin-top: 8rpx;
}

.effect-image-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.preview-effect-image {
  width: 100%;
  height: 360rpx;
  border-radius: 22rpx;
  background: rgba(8, 32, 61, 0.06);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
}
