page {
  background:
    radial-gradient(circle at top left, rgba(29, 78, 216, 0.1), transparent 28%),
    radial-gradient(circle at top right, rgba(20, 184, 166, 0.08), transparent 24%),
    linear-gradient(180deg, #f4f9ff 0%, #edf4ff 100%);
  color: #08203d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.panel,
.hero-card,
.card,
.empty-box {
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.07);
  backdrop-filter: blur(12px);
}

.hero-card,
.panel,
.empty-box {
  padding: 30rpx;
}

.hero-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(241, 248, 255, 0.94) 100%);
}

.title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #08203d;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #57708f;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.btn-primary,
.btn-ghost,
.btn-danger {
  border-radius: 20rpx;
  font-size: 26rpx;
  border: none;
  font-weight: 700;
  transform: scale(1);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.btn-primary {
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
  color: #fff;
}

.btn-primary::after,
.btn-ghost::after,
.btn-danger::after {
  border: none;
}

.btn-ghost {
  background: rgba(29, 78, 216, 0.08);
  color: #1d4ed8;
}

.btn-danger {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
}

.btn-primary.button-hover,
.btn-ghost.button-hover,
.btn-danger.button-hover {
  transform: scale(0.985);
  opacity: 0.94;
}

.search-input,
.text-input {
  height: 84rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(29, 78, 216, 0.1);
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #08203d;
}

.chip-row {
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(29, 78, 216, 0.07);
  color: #244f88;
  font-size: 24rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}

.chip.active {
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
  color: #fff;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  padding: 24rpx;
}

.meta {
  font-size: 22rpx;
  color: #6b86a8;
}

.badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(29, 78, 216, 0.1);
  color: #1d4ed8;
  font-size: 22rpx;
}
