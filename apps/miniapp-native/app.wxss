page {
  background: #f6f6f6;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

.page {
  padding: 28rpx 30rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.panel,
.hero-card,
.card,
.empty-box {
  background: #ffffff;
  border: 0;
  border-radius: 28rpx;
  box-shadow: none;
}

.hero-card,
.panel,
.empty-box {
  padding: 30rpx;
}

.hero-card {
  background: #ffffff;
}

.title {
  display: block;
  font-size: 38rpx;
  font-weight: 850;
  color: #1f2329;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7a7f87;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.btn-primary,
.btn-ghost,
.btn-danger {
  border-radius: 20rpx;
  font-size: 26rpx;
  border: none;
  font-weight: 700;
  transform: scale(1);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.btn-primary {
  background: #46b855;
  color: #fff;
}

.btn-primary::after,
.btn-ghost::after,
.btn-danger::after {
  border: none;
}

.btn-ghost {
  background: #f1f2f3;
  color: #1f2329;
}

.btn-danger {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
}

.btn-primary.button-hover,
.btn-ghost.button-hover,
.btn-danger.button-hover {
  transform: scale(0.985);
  opacity: 0.94;
}

.search-input,
.text-input {
  height: 84rpx;
  background: #ffffff;
  border: 0;
  border-radius: 24rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1f2329;
}

.chip-row {
  white-space: nowrap;
}

.chip {
  display: inline-flex;
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f2f3;
  color: #555b62;
  font-size: 24rpx;
  margin-right: 14rpx;
  margin-bottom: 14rpx;
}

.chip.active {
  background: #46b855;
  color: #fff;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.card {
  padding: 24rpx;
}

.meta {
  font-size: 22rpx;
  color: #8a8a8a;
}

.badge {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #eef8ef;
  color: #46b855;
  font-size: 22rpx;
}
