.service-detail-page {
  gap: 24rpx;
}

.detail-hero {
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
}

.detail-hero .meta {
  color: #46b855;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.detail-title {
  color: #1f2329;
  line-height: 1.3;
}

.detail-subtitle {
  color: #8a8a8a;
}

.detail-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.detail-badges .badge {
  background: #eef8ef;
  color: #46b855;
  font-weight: 800;
}

.detail-section-title {
  font-size: 32rpx;
  font-weight: 900;
}

.detail-text {
  display: block;
  margin-top: 18rpx;
  color: #33383f;
  font-size: 27rpx;
  line-height: 1.85;
}

.detail-actions {
  display: flex;
  width: 100%;
}

.detail-action-btn {
  margin: 0;
  width: 100%;
  padding: 0 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 24rpx;
  background: #46b855;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 850;
  text-align: center;
}

.interactive-button {
  transform: scale(1);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.interactive-button-hover {
  transform: scale(0.985);
  opacity: 0.94;
}

.detail-action-btn::after {
  border: none;
}

.detail-tip {
  display: block;
  margin-top: 14rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 1.7;
}

.detail-gallery {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 18rpx;
}

.detail-gallery-image {
  width: 100%;
  height: 360rpx;
  border-radius: 26rpx;
  background: #eeeeee;
  display: block;
}

.detail-gallery-image-fallback {
  background: linear-gradient(135deg, #e8f8e9 0%, #f4f4f4 100%);
}

.detail-gallery-empty {
  margin-top: 16rpx;
}
