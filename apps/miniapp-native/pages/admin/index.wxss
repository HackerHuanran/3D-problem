.admin-page {
  gap: 20rpx;
}

.admin-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.admin-tab {
  padding: 14rpx 22rpx;
  border-radius: 20rpx;
  background: rgba(29, 78, 216, 0.08);
  color: #1d4ed8;
  font-size: 26rpx;
}

.admin-tab.active {
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
  color: #fff;
}

.admin-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.admin-actions-buttons {
  flex-wrap: wrap;
}

.admin-action-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.admin-action-btn::after {
  border: none;
}

.admin-action-btn[disabled] {
  opacity: 0.72;
}

.admin-action-view {
  background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
  color: #ffffff;
}

.admin-action-approve {
  background: linear-gradient(135deg, #0891b2 0%, #14b8a6 100%);
  color: #ffffff;
}

.admin-action-disabled {
  background: linear-gradient(135deg, #cbd5e1 0%, #94a3b8 100%);
  color: rgba(255, 255, 255, 0.96);
}

.admin-action-reject {
  background: linear-gradient(135deg, #dc2626 0%, #f97316 100%);
  color: #ffffff;
}

.admin-action-delete {
  background: linear-gradient(135deg, #475569 0%, #334155 100%);
  color: #ffffff;
}

.admin-link {
  color: #1d4ed8;
  font-size: 26rpx;
  line-height: 1.4;
  padding: 6rpx 0;
}

.admin-link[disabled] {
  opacity: 0.6;
}

.admin-link-right {
  margin-left: auto;
}

.stats-overview {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 22rpx;
  margin-bottom: 22rpx;
}

.stats-overview-card {
  padding: 20rpx 12rpx;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
  text-align: center;
}

.stats-overview-value {
  display: block;
  color: #08203d;
  font-size: 38rpx;
  font-weight: 800;
}

.stats-overview-label {
  display: block;
  margin-top: 10rpx;
  color: #6b86a8;
  font-size: 22rpx;
  line-height: 1.5;
}

.analytics-card {
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.analytics-time-block {
  margin-top: 18rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.analytics-time-title {
  display: block;
  color: #08203d;
  font-size: 28rpx;
  font-weight: 800;
}

.analytics-time-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.analytics-time-chip {
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
}

.analytics-time-chip-label {
  display: block;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
}

.analytics-time-chip-value {
  display: block;
  margin-top: 6rpx;
  color: #57708f;
  font-size: 22rpx;
}

.admin-problem-image {
  width: 100%;
  height: 240rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  background: #e8eef6;
}

.admin-problem-image-fallback {
  background: linear-gradient(135deg, #dbeafe 0%, #d1fae5 100%);
}

.badge-done {
  background: rgba(20, 184, 166, 0.12);
  color: #0f766e;
}

.feedback-preview {
  display: block;
  margin-top: 12rpx;
  color: #57708f;
  font-size: 24rpx;
  line-height: 1.65;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.service-form {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.service-form-tip {
  color: #5b7491;
  font-size: 24rpx;
  line-height: 1.7;
}

.service-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.service-field-label {
  color: #415a77;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.service-image-picker {
  width: 100%;
  height: 240rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.2);
}

.service-image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.service-image-picker-small,
.service-thumb-card {
  width: calc((100% - 32rpx) / 3);
  height: 180rpx;
}

.service-image-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.service-thumb-card {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.2);
}

.service-thumb-image {
  width: 100%;
  height: 100%;
  display: block;
}

.service-thumb-remove {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  font-size: 20rpx;
}

.service-image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #eff6ff 0%, #ecfeff 100%);
}

.service-image-placeholder-text {
  color: #5b7491;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.admin-input,
.admin-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.2);
  color: #08203d;
  font-size: 28rpx;
  line-height: 88rpx;
}

.admin-input {
  height: 88rpx;
}

.service-textarea {
  min-height: 180rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.7;
}

.announcement-textarea {
  min-height: 220rpx;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  line-height: 1.7;
}

.announcement-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid rgba(148, 163, 184, 0.2);
}

.admin-input::placeholder,
.admin-textarea::placeholder {
  color: #7b8da6;
  font-size: 26rpx;
  line-height: 1.6;
}

.service-admin-gallery {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.service-admin-gallery-image {
  width: calc((100% - 24rpx) / 3);
  height: 180rpx;
  border-radius: 18rpx;
  background: #e8eef6;
}

.reward-order-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.reward-order-image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  background: #e8eef6;
}

.reward-order-image-fallback {
  background: linear-gradient(135deg, #dbeafe 0%, #d1fae5 100%);
}

.reward-order-copy {
  min-width: 0;
  flex: 1;
}
