<view class="page admin-page">
  <view wx:if="{{!isAdmin}}" class="hero-card">
    <text class="title">管理后台</text>
    <text class="subtitle">当前账号不是管理员，无法进入后台。</text>
  </view>

  <block wx:if="{{isAdmin}}">
    <view class="hero-card">
      <text class="title">管理后台</text>
      <text class="subtitle">审核投稿、管理问题图片、查看平台内容。</text>
      <view class="admin-tabs">
        <view class="admin-tab {{section === 'submissions' ? 'active' : ''}}" data-section="submissions" bindtap="switchSection">投稿审核</view>
        <view class="admin-tab {{section === 'feedback' ? 'active' : ''}}" data-section="feedback" bindtap="switchSection">用户反馈</view>
        <view class="admin-tab {{section === 'announcements' ? 'active' : ''}}" data-section="announcements" bindtap="switchSection">公告通知</view>
        <view class="admin-tab {{section === 'analytics' ? 'active' : ''}}" data-section="analytics" bindtap="switchSection">使用统计</view>
        <view class="admin-tab {{section === 'problems' ? 'active' : ''}}" data-section="problems" bindtap="switchSection">问题图片</view>
        <view class="admin-tab {{section === 'rewards' ? 'active' : ''}}" data-section="rewards" bindtap="switchSection">积分商品</view>
        <view class="admin-tab {{section === 'rewardOrders' ? 'active' : ''}}" data-section="rewardOrders" bindtap="switchSection">兑换订单</view>
      </view>
    </view>

    <view wx:if="{{section === 'analytics'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">使用统计</text>
        <text class="admin-link admin-link-right" bindtap="loadUsageStats">刷新</text>
      </view>
      <view class="stats-overview">
        <view class="stats-overview-card">
          <text class="stats-overview-value">{{usageSummary.today}}</text>
          <text class="stats-overview-label">今日使用人数</text>
        </view>
        <view class="stats-overview-card">
          <text class="stats-overview-value">{{usageSummary.yesterday}}</text>
          <text class="stats-overview-label">昨日使用人数</text>
        </view>
        <view class="stats-overview-card">
          <text class="stats-overview-value">{{usageSummary.total}}</text>
          <text class="stats-overview-label">近 14 天累计</text>
        </view>
      </view>
      <view wx:if="{{usageTimeline.today.length}}" class="analytics-time-block">
        <text class="analytics-time-title">今日浏览时段</text>
        <view class="analytics-time-list">
          <view wx:for="{{usageTimeline.today}}" wx:key="hour" class="analytics-time-chip">
            <text class="analytics-time-chip-label">{{item.label}}</text>
            <text class="analytics-time-chip-value">{{item.userCount}} 人</text>
          </view>
        </view>
      </view>
      <view wx:if="{{usageTimeline.yesterday.length}}" class="analytics-time-block">
        <text class="analytics-time-title">昨日浏览时段</text>
        <view class="analytics-time-list">
          <view wx:for="{{usageTimeline.yesterday}}" wx:key="hour" class="analytics-time-chip">
            <text class="analytics-time-chip-label">{{item.label}}</text>
            <text class="analytics-time-chip-value">{{item.userCount}} 人</text>
          </view>
        </view>
      </view>
      <view wx:if="{{!usageStats.length}}" class="empty-box">
        <text class="subtitle">暂时还没有统计数据，等用户打开小程序后会自动累计。</text>
      </view>
    </view>

    <view wx:if="{{section === 'submissions'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">用户投稿</text>
        <text class="admin-link admin-link-right" bindtap="loadSubmissions">刷新</text>
      </view>
      <view class="submission-filter-row">
        <view class="submission-filter-chip {{submissionFilter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="switchSubmissionFilter">全部 {{submissionCounts.all}}</view>
        <view class="submission-filter-chip {{submissionFilter === 'problem' ? 'active' : ''}}" data-filter="problem" bindtap="switchSubmissionFilter">问题投稿 {{submissionCounts.problem}}</view>
        <view class="submission-filter-chip {{submissionFilter === 'knowledge' ? 'active' : ''}}" data-filter="knowledge" bindtap="switchSubmissionFilter">知识投稿 {{submissionCounts.knowledge}}</view>
        <view class="submission-filter-chip {{submissionFilter === 'service' ? 'active' : ''}}" data-filter="service" bindtap="switchSubmissionFilter">服务审核 {{submissionCounts.service}}</view>
      </view>
      <view wx:if="{{filteredSubmissions.length}}" class="list">
        <view wx:for="{{filteredSubmissions}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.title}}</text>
            <text class="badge">{{item.statusText}}</text>
          </view>
          <text class="submission-type-badge {{item.submissionType === 'knowledge' ? 'knowledge' : item.submissionType === 'service' ? 'service' : 'problem'}}">{{item.submissionTypeText}}</text>
          <text class="subtitle">{{item.subtitle}}</text>
          <text wx:if="{{item.submissionType === 'service'}}" class="subtitle">微信号：{{item.contact || '未填写'}} · 展示图片 {{item.images.length || 0}} 张</text>
          <view class="admin-actions admin-actions-buttons">
            <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="openSubmissionDetail" disabled="{{opLoading && opTargetId === item.id}}">查看详情</button>
            <button class="admin-action-btn {{item.status === 'published' ? 'admin-action-disabled' : 'admin-action-approve'}}" size="mini" data-id="{{item.id}}" bindtap="approveSubmission" disabled="{{item.status === 'published' || (opLoading && opTargetId === item.id)}}">{{item.status === 'published' ? '已通过' : '通过'}}</button>
            <button class="admin-action-btn admin-action-reject" size="mini" data-id="{{item.id}}" bindtap="rejectSubmission" disabled="{{opLoading && opTargetId === item.id}}">拒绝</button>
            <button class="admin-action-btn admin-action-delete" size="mini" data-id="{{item.id}}" bindtap="deleteSubmission" disabled="{{opLoading && opTargetId === item.id}}">删除</button>
          </view>
        </view>
        <view wx:if="{{submissionFilter === 'service' && serviceSubmissionHasMore}}" class="empty-box compact-empty">
          <text class="subtitle">继续上拉，加载更多服务入驻</text>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">{{submissionFilter === 'knowledge' ? '暂无知识投稿' : submissionFilter === 'service' ? '暂无服务入驻' : submissionFilter === 'problem' ? '暂无问题投稿' : '暂无投稿'}}</text>
      </view>

      <block wx:if="{{submissionFilter === 'service'}}">
        <view class="row service-admin-head">
          <text class="title" style="font-size: 30rpx;">已发布服务</text>
          <text class="admin-link admin-link-right" bindtap="loadServices">刷新</text>
        </view>
        <view wx:if="{{services.length}}" class="list">
          <view wx:for="{{services}}" wx:key="id" class="card">
            <view class="row">
              <text class="title" style="font-size: 28rpx; flex: 1;">{{item.studioName}}</text>
              <text class="badge">{{item.machineCount}}</text>
            </view>
            <text class="subtitle">机器型号：{{item.machineModel}}</text>
            <text class="subtitle">服务描述：{{item.descriptionPreview || '未填写描述'}}</text>
            <text class="subtitle">微信号：{{item.contact || '未填写微信号'}}</text>
            <text class="subtitle">{{item.wechatQrImageDisplay ? '已上传联系方式二维码' : '未上传联系方式二维码'}}</text>
            <view wx:if="{{item.imageDisplays.length}}" class="service-admin-gallery">
              <image wx:for="{{item.imageDisplays}}" wx:key="index" class="service-admin-gallery-image" src="{{item}}" mode="aspectFill"></image>
            </view>
            <view class="admin-actions admin-actions-buttons">
              <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="openPublishedServiceDetail" disabled="{{opLoading && opTargetId === item.id}}">查看详情</button>
              <button class="admin-action-btn admin-action-approve" size="mini" data-id="{{item.id}}" bindtap="editPublishedService" disabled="{{opLoading && opTargetId === item.id}}">修改</button>
              <button class="admin-action-btn admin-action-delete" size="mini" data-id="{{item.id}}" bindtap="deleteService" disabled="{{opLoading && opTargetId === item.id}}">删除</button>
            </view>
          </view>
          <view wx:if="{{servicesLoadingMore}}" class="empty-box compact-empty">
            <text class="subtitle">正在加载更多服务...</text>
          </view>
          <view wx:elif="{{!serviceHasMore}}" class="empty-box compact-empty">
            <text class="subtitle">已显示全部服务</text>
          </view>
        </view>
        <view wx:else class="empty-box">
          <text class="subtitle">当前还没有已发布的打印服务</text>
        </view>
      </block>
    </view>

    <view wx:if="{{section === 'feedback'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">用户反馈</text>
        <text class="admin-link admin-link-right" bindtap="loadFeedback">刷新</text>
      </view>
      <view wx:if="{{feedbackList.length}}" class="list">
        <view wx:for="{{feedbackList}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.title}}</text>
            <text class="badge {{item.status === 'resolved' ? 'badge-done' : ''}}">{{item.statusText}}</text>
          </view>
          <text class="subtitle">{{item.type}} · {{item.userName}}</text>
          <text class="feedback-preview">{{item.content}}</text>
          <view class="admin-actions admin-actions-buttons">
            <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="viewFeedback" disabled="{{opLoading && opTargetId === item.id}}">查看详情</button>
            <button class="admin-action-btn {{item.status === 'resolved' ? 'admin-action-disabled' : 'admin-action-approve'}}" size="mini" data-id="{{item.id}}" bindtap="resolveFeedback" disabled="{{item.status === 'resolved' || (opLoading && opTargetId === item.id)}}">{{item.status === 'resolved' ? '已处理' : '标记处理'}}</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">暂无用户反馈</text>
      </view>
    </view>

    <view wx:if="{{section === 'announcements'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">公告通知</text>
        <text class="admin-link admin-link-right" bindtap="loadAnnouncements">刷新</text>
      </view>

      <view class="service-form">
        <text class="service-form-tip">发布新功能或重要提醒后，用户进入小程序会看到弹窗；用户点过按钮后，同一条公告不会重复弹出。</text>
        <view class="service-field">
          <text class="service-field-label">公告标题</text>
          <input class="admin-input" placeholder="例如：积分兑换上线啦" value="{{announcementForm.title}}" data-field="title" bindinput="onAnnouncementInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">公告内容</text>
          <textarea class="admin-textarea announcement-textarea" maxlength="500" placeholder="写给用户看的更新内容，建议 1-3 句话。" value="{{announcementForm.content}}" data-field="content" bindinput="onAnnouncementInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">按钮文字</text>
          <input class="admin-input" placeholder="例如：知道了" value="{{announcementForm.confirmText}}" data-field="confirmText" bindinput="onAnnouncementInput" />
        </view>
        <view class="announcement-switch-row">
          <view>
            <text class="service-field-label">是否启用</text>
            <text class="subtitle">启用后，用户进入小程序会看到这条公告。</text>
          </view>
          <switch checked="{{announcementForm.enabled}}" color="#1d4ed8" bindchange="onAnnouncementEnabledChange" />
        </view>
        <view class="admin-actions admin-actions-buttons">
          <button class="admin-action-btn admin-action-approve" size="mini" bindtap="saveAnnouncement" disabled="{{opLoading && opAction === 'save-announcement'}}">{{announcementForm.id ? '保存公告' : '发布公告'}}</button>
          <button class="admin-action-btn admin-action-delete" size="mini" bindtap="resetAnnouncementForm" disabled="{{opLoading && opAction === 'save-announcement'}}">清空表单</button>
        </view>
      </view>

      <view wx:if="{{announcements.length}}" class="list">
        <view wx:for="{{announcements}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.title}}</text>
            <text class="badge {{item.enabled ? 'badge-done' : ''}}">{{item.statusText}}</text>
          </view>
          <text class="feedback-preview">{{item.content}}</text>
          <view class="admin-actions admin-actions-buttons">
            <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="editAnnouncement" disabled="{{opLoading && opTargetId === item.id}}">修改</button>
            <button class="admin-action-btn {{item.enabled ? 'admin-action-disabled' : 'admin-action-approve'}}" size="mini" data-id="{{item.id}}" bindtap="toggleAnnouncement" disabled="{{opLoading && opTargetId === item.id}}">{{item.enabled ? '停用' : '启用'}}</button>
            <button class="admin-action-btn admin-action-delete" size="mini" data-id="{{item.id}}" bindtap="deleteAnnouncement" disabled="{{opLoading && opTargetId === item.id}}">删除</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">还没有公告，发布一条后用户进入小程序就能看到。</text>
      </view>
    </view>

    <view wx:if="{{section === 'problems'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">问题管理</text>
        <text class="admin-link admin-link-right" bindtap="refreshProblems">刷新</text>
      </view>
      <view wx:if="{{problems.length}}" class="list">
        <view wx:for="{{problems}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.title}}</text>
            <text class="badge">{{item.category}}</text>
          </view>
          <image wx:if="{{item.image_url}}" class="admin-problem-image" src="{{item.image_url}}" mode="aspectFill"></image>
          <view wx:else class="admin-problem-image admin-problem-image-fallback"></view>
          <view class="admin-actions">
            <text class="admin-link" data-id="{{item.id}}" bindtap="openProblemDetail">查看详情</text>
            <text class="admin-link" data-id="{{item.id}}" bindtap="openProblemEditor">修改问题</text>
            <text class="admin-link" data-id="{{item.id}}" bindtap="openProblemImagePicker">上传图片</text>
          </view>
        </view>
        <view wx:if="{{!problemHasMore}}" class="empty-box">
          <text class="subtitle">已经到底了</text>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">暂无问题图片</text>
      </view>
    </view>

    <view wx:if="{{section === 'services'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">打印服务管理</text>
        <text class="admin-link admin-link-right" bindtap="loadServices">刷新</text>
      </view>

      <view class="service-form">
        <text class="service-form-tip">只有管理员可以维护这里的打印服务信息，普通用户只能浏览查看。</text>
        <view class="service-field">
          <text class="service-field-label">工作室 / 工厂名称</text>
          <input class="admin-input" placeholder="例如：沈阳某某打印工作室" value="{{serviceForm.studioName}}" data-field="studioName" bindinput="onServiceInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">机器型号</text>
          <input class="admin-input" placeholder="例如：Bambu Lab X1C / K1 Max" value="{{serviceForm.machineModel}}" data-field="machineModel" bindinput="onServiceInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">机器数量</text>
          <input class="admin-input" placeholder="例如：6 台" value="{{serviceForm.machineCount}}" data-field="machineCount" bindinput="onServiceInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">服务描述</text>
          <textarea class="admin-textarea service-textarea" maxlength="300" placeholder="例如：可打印手办、结构件、原型件，支持 PLA / PETG / ABS，支持小批量打样与发货。" value="{{serviceForm.description}}" data-field="description" bindinput="onServiceInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">展示图片（最多 3 张）</text>
          <text class="subtitle">选填，不上传也可以保存。</text>
          <view class="service-image-grid">
            <view wx:for="{{serviceForm.imageDisplays}}" wx:key="index" class="service-thumb-card">
              <image class="service-thumb-image" src="{{item}}" mode="aspectFill"></image>
              <text class="service-thumb-remove" data-index="{{index}}" bindtap="removeServiceImage">删除</text>
            </view>
            <view wx:if="{{serviceForm.imageDisplays.length < 3}}" class="service-image-picker service-image-picker-small" bindtap="chooseServiceImages">
              <view class="service-image-placeholder">
                <text class="service-image-placeholder-text">点击上传图片</text>
              </view>
            </view>
          </view>
          <view class="admin-actions">
            <text wx:if="{{serviceForm.imageDisplays.length < 3}}" class="admin-link" bindtap="chooseServiceImages">继续添加</text>
            <text wx:else class="subtitle">已达到 3 张上限</text>
          </view>
        </view>
        <view class="service-field">
          <text class="service-field-label">联系方式</text>
          <input class="admin-input" placeholder="例如：微信号 model-help-01" value="{{serviceForm.contact}}" data-field="contact" bindinput="onServiceInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">联系方式二维码</text>
          <view class="service-image-picker" bindtap="chooseWechatQrImage">
            <image wx:if="{{serviceForm.wechatQrImageDisplay}}" class="service-image-preview" src="{{serviceForm.wechatQrImageDisplay}}" mode="aspectFill"></image>
            <view wx:else class="service-image-placeholder">
              <text class="service-image-placeholder-text">点击上传联系方式二维码</text>
            </view>
          </view>
          <view class="admin-actions">
            <text class="admin-link" bindtap="chooseWechatQrImage">选择二维码</text>
            <text wx:if="{{serviceForm.wechatQrImageDisplay}}" class="admin-link" bindtap="clearWechatQrImage">清空二维码</text>
          </view>
        </view>
        <view class="admin-actions admin-actions-buttons">
          <button class="admin-action-btn admin-action-approve" size="mini" bindtap="saveService" disabled="{{opLoading && opAction === 'save-service'}}">{{serviceForm.id ? '保存修改' : '新增服务'}}</button>
          <button class="admin-action-btn admin-action-delete" size="mini" bindtap="resetServiceForm" disabled="{{opLoading && opAction === 'save-service'}}">清空表单</button>
        </view>
      </view>

      <view wx:if="{{services.length}}" class="list">
        <view wx:for="{{services}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.studioName}}</text>
            <text class="badge">{{item.machineCount}}</text>
          </view>
          <text class="subtitle">机器型号：{{item.machineModel}}</text>
          <text class="subtitle">服务描述：{{item.descriptionPreview || '未填写描述'}}</text>
          <text class="subtitle">微信号：{{item.contact || '未填写微信号'}}</text>
          <text class="subtitle">{{item.wechatQrImageDisplay ? '已上传联系方式二维码' : '未上传联系方式二维码'}}</text>
          <view wx:if="{{item.imageDisplays.length}}" class="service-admin-gallery">
            <image wx:for="{{item.imageDisplays}}" wx:key="index" class="service-admin-gallery-image" src="{{item}}" mode="aspectFill"></image>
          </view>
          <view class="admin-actions admin-actions-buttons">
            <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="editService" disabled="{{opLoading && opTargetId === item.id}}">修改</button>
            <button class="admin-action-btn admin-action-delete" size="mini" data-id="{{item.id}}" bindtap="deleteService" disabled="{{opLoading && opTargetId === item.id}}">删除</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">还没有添加打印服务信息</text>
      </view>
    </view>

    <view wx:if="{{section === 'rewards'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">积分商品管理</text>
        <text class="admin-link admin-link-right" bindtap="loadRewardGoods">刷新</text>
      </view>

      <view class="service-form">
        <text class="service-form-tip">这里上架积分兑换耗材，用户在小程序里可直接用积分兑换。</text>
        <view class="service-field">
          <text class="service-field-label">商品名称</text>
          <input class="admin-input" placeholder="例如：PLA 白色 1kg" value="{{rewardForm.name}}" data-field="name" bindinput="onRewardInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">商品图片</text>
          <view class="service-image-picker" bindtap="chooseRewardImage">
            <image wx:if="{{rewardForm.imageDisplayUrl}}" class="service-image-preview" src="{{rewardForm.imageDisplayUrl}}" mode="aspectFill"></image>
            <view wx:else class="service-image-placeholder">
              <text class="service-image-placeholder-text">点击上传商品图片</text>
            </view>
          </view>
          <view class="admin-actions">
            <text class="admin-link" bindtap="chooseRewardImage">选择图片</text>
            <text wx:if="{{rewardForm.imageDisplayUrl}}" class="admin-link" bindtap="clearRewardImage">清空图片</text>
          </view>
        </view>
        <view class="service-field">
          <text class="service-field-label">商品数量</text>
          <input class="admin-input" type="number" placeholder="例如：20" value="{{rewardForm.quantity}}" data-field="quantity" bindinput="onRewardInput" />
        </view>
        <view class="service-field">
          <text class="service-field-label">所需积分</text>
          <input class="admin-input" type="number" placeholder="例如：10（代表 10 积分兑换 1 卷）" value="{{rewardForm.pointsCost}}" data-field="pointsCost" bindinput="onRewardInput" />
        </view>
        <view class="admin-actions admin-actions-buttons">
          <button class="admin-action-btn admin-action-approve" size="mini" bindtap="saveRewardGood" disabled="{{opLoading && opAction === 'save-reward'}}">{{rewardForm.id ? '保存修改' : '上架商品'}}</button>
          <button class="admin-action-btn admin-action-delete" size="mini" bindtap="resetRewardForm" disabled="{{opLoading && opAction === 'save-reward'}}">清空表单</button>
        </view>
      </view>

      <view wx:if="{{rewardGoods.length}}" class="list">
        <view wx:for="{{rewardGoods}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.name}}</text>
            <text class="badge">剩余 {{item.quantity}}</text>
          </view>
          <image wx:if="{{item.imageDisplayUrl}}" class="admin-problem-image" src="{{item.imageDisplayUrl}}" mode="aspectFill"></image>
          <view wx:else class="admin-problem-image admin-problem-image-fallback"></view>
          <text class="subtitle">兑换积分：{{item.pointsCost}} 积分 / 卷</text>
          <view class="admin-actions admin-actions-buttons">
            <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="editRewardGood" disabled="{{opLoading && opTargetId === item.id}}">修改</button>
            <button class="admin-action-btn admin-action-delete" size="mini" data-id="{{item.id}}" bindtap="deleteRewardGood" disabled="{{opLoading && opTargetId === item.id}}">删除</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">还没有上架积分商品</text>
      </view>
    </view>

    <view wx:if="{{section === 'rewardOrders'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">兑换订单</text>
        <text class="admin-link admin-link-right" bindtap="loadRewardOrders">刷新</text>
      </view>
      <view wx:if="{{rewardOrders.length}}" class="list">
        <view wx:for="{{rewardOrders}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.goodsName}}</text>
            <text class="badge {{item.status === 'done' ? 'badge-done' : ''}}">{{item.statusText}}</text>
          </view>
          <view class="reward-order-row">
            <image wx:if="{{item.goodsImageDisplay}}" class="reward-order-image" src="{{item.goodsImageDisplay}}" mode="aspectFill"></image>
            <view wx:else class="reward-order-image reward-order-image-fallback"></view>
            <view class="reward-order-copy">
              <text class="subtitle">消耗积分：{{item.pointsCost}}</text>
              <text class="subtitle">用户：{{item.userId}}</text>
              <text class="subtitle">地址：{{item.addressText || '未填写地址'}}</text>
            </view>
          </view>
          <view class="admin-actions admin-actions-buttons">
            <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="viewRewardOrderAddress" disabled="{{opLoading && opTargetId === item.id}}">查看地址</button>
            <button class="admin-action-btn {{item.status === 'done' ? 'admin-action-disabled' : 'admin-action-approve'}}" size="mini" data-id="{{item.id}}" bindtap="markRewardOrderDone" disabled="{{item.status === 'done' || (opLoading && opTargetId === item.id)}}">{{item.status === 'done' ? '已处理' : '标记处理'}}</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">暂无兑换订单</text>
      </view>
    </view>
  </block>
</view>
