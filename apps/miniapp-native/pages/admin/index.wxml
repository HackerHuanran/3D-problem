<view class="page admin-page">
  <view wx:if="{{!isAdmin}}" class="hero-card">
    <text class="title">管理后台</text>
    <text class="subtitle">当前账号不是管理员，无法进入后台。</text>
  </view>

  <block wx:if="{{isAdmin}}">
    <view class="hero-card">
      <text class="title">管理后台</text>
      <text class="subtitle">审核投稿、管理问题图片、查看平台内容。</text>
      <view class="admin-tabs">
        <view class="admin-tab {{section === 'submissions' ? 'active' : ''}}" data-section="submissions" bindtap="switchSection">投稿审核</view>
        <view class="admin-tab {{section === 'problems' ? 'active' : ''}}" data-section="problems" bindtap="switchSection">问题图片</view>
      </view>
    </view>

    <view wx:if="{{section === 'submissions'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">用户投稿</text>
        <text class="admin-link admin-link-right" bindtap="loadSubmissions">刷新</text>
      </view>
      <view wx:if="{{loading}}" class="empty-box">
        <text class="subtitle">正在加载…</text>
      </view>
      <view wx:elif="{{submissions.length}}" class="list">
        <view wx:for="{{submissions}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.title}}</text>
            <text class="badge">{{item.statusText}}</text>
          </view>
          <text class="subtitle">{{item.subtitle}}</text>
          <view class="admin-actions admin-actions-buttons">
            <button class="admin-action-btn admin-action-view" size="mini" data-id="{{item.id}}" bindtap="openSubmissionDetail" disabled="{{opLoading && opTargetId === item.id}}">查看详情</button>
            <button class="admin-action-btn {{item.status === 'published' ? 'admin-action-disabled' : 'admin-action-approve'}}" size="mini" data-id="{{item.id}}" bindtap="approveSubmission" disabled="{{item.status === 'published' || (opLoading && opTargetId === item.id)}}">{{item.status === 'published' ? '已通过' : '通过'}}</button>
            <button class="admin-action-btn admin-action-reject" size="mini" data-id="{{item.id}}" bindtap="rejectSubmission" disabled="{{opLoading && opTargetId === item.id}}">拒绝</button>
            <button class="admin-action-btn admin-action-delete" size="mini" data-id="{{item.id}}" bindtap="deleteSubmission" disabled="{{opLoading && opTargetId === item.id}}">删除</button>
          </view>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">暂无投稿</text>
      </view>
    </view>

    <view wx:if="{{section === 'problems'}}" class="panel">
      <view class="row">
        <text class="title" style="font-size: 32rpx;">问题图片</text>
        <text class="admin-link admin-link-right" bindtap="refreshProblems">刷新</text>
      </view>
      <view wx:if="{{loading}}" class="empty-box">
        <text class="subtitle">正在加载…</text>
      </view>
      <view wx:elif="{{problems.length}}" class="list">
        <view wx:for="{{problems}}" wx:key="id" class="card">
          <view class="row">
            <text class="title" style="font-size: 28rpx; flex: 1;">{{item.title}}</text>
            <text class="badge">{{item.category}}</text>
          </view>
          <image wx:if="{{item.image_url}}" class="admin-problem-image" src="{{item.image_url}}" mode="aspectFill"></image>
          <view wx:else class="admin-problem-image admin-problem-image-fallback"></view>
          <view class="admin-actions">
            <text class="admin-link" data-id="{{item.id}}" bindtap="openProblemDetail">查看详情</text>
            <text class="admin-link" data-id="{{item.id}}" bindtap="openProblemImagePicker">上传图片</text>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="empty-box">
          <text class="subtitle">正在加载更多…</text>
        </view>
        <view wx:if="{{!problemHasMore}}" class="empty-box">
          <text class="subtitle">已经到底了</text>
        </view>
      </view>
      <view wx:else class="empty-box">
        <text class="subtitle">暂无问题图片</text>
      </view>
    </view>
  </block>
</view>
