.feedback-page {
  gap: 22rpx;
}

.feedback-hero {
  background:
    radial-gradient(circle at 12% 4%, rgba(20, 184, 166, 0.18), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(241, 248, 255, 0.94) 100%);
}

.feedback-panel {
  display: flex;
  flex-direction: column;
}

.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.type-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(29, 78, 216, 0.07);
  color: #244f88;
  font-size: 24rpx;
  font-weight: 700;
}

.type-chip.active {
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(29, 78, 216, 0.16);
}

.field-label {
  display: block;
  margin-top: 26rpx;
}

.feedback-textarea {
  min-height: 300rpx;
}

.count-text {
  align-self: flex-end;
  margin-top: 10rpx;
  color: #8da0b7;
  font-size: 22rpx;
}

.submit-btn {
  margin-top: 4rpx;
}
