.address-page {
  gap: 22rpx;
}

.field-label {
  display: block;
  margin-top: 24rpx;
}

.picker-box {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(29, 78, 216, 0.1);
  box-sizing: border-box;
}

.picker-text {
  color: #08203d;
  font-size: 28rpx;
}

.picker-placeholder {
  color: #90a0b5;
  font-size: 28rpx;
}

.address-textarea {
  min-height: 220rpx;
}

.default-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
}

.default-box {
  width: 30rpx;
  height: 30rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(29, 78, 216, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.default-box.active {
  background: rgba(29, 78, 216, 0.12);
  border-color: #1d4ed8;
}

.default-box-icon {
  color: #1d4ed8;
  font-size: 20rpx;
  font-weight: 800;
}

.default-text {
  color: #415a77;
  font-size: 24rpx;
}

.address-form-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.address-btn {
  flex: 1;
  margin: 0;
  height: 78rpx;
  line-height: 78rpx;
}

.address-name {
  flex: 1;
  color: #08203d;
  font-size: 28rpx;
  font-weight: 760;
}

.address-detail {
  display: block;
  margin-top: 10rpx;
  color: #57708f;
  font-size: 24rpx;
  line-height: 1.7;
}

.address-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.address-link {
  color: #1d4ed8;
  font-size: 24rpx;
}

.address-link.danger {
  color: #dc2626;
}

.add-address-btn {
  margin-top: 4rpx;
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  box-sizing: border-box;
}
