.library-hero {
  border-radius: 30rpx;
  background: #ffffff;
}

.library-hero .meta {
  color: #46b855;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.library-search {
  margin-top: 24rpx;
}

.library-search .search-input {
  background: #f4f4f4;
}

.panel {
  padding: 28rpx;
}

.problem-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.problem-card {
  display: flex;
  gap: 18rpx;
  padding: 18rpx 0;
  border-radius: 0;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
  box-shadow: none;
}

.problem-card:last-child {
  border-bottom: 0;
}

.interactive-card {
  transform: scale(1);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.interactive-card-hover {
  transform: scale(0.988);
  opacity: 0.95;
}

.problem-thumb {
  width: 174rpx;
  height: 142rpx;
  border-radius: 22rpx;
  background: #eeeeee;
  flex-shrink: 0;
  overflow: hidden;
}

.problem-thumb-fallback {
  background: linear-gradient(135deg, #e8f8e9 0%, #f4f4f4 100%);
}

.problem-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.problem-head {
  align-items: flex-start;
}

.problem-title {
  flex: 1;
  color: #1f2329;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.42;
}

.problem-subtitle {
  margin-top: 8rpx;
  color: #8a8a8a;
  line-height: 1.45;
}

.problem-action {
  margin-top: auto;
  padding-top: 12rpx;
  color: #46b855;
  font-size: 23rpx;
  font-weight: 800;
}

.problem-reactions {
  width: 76rpx;
  height: 142rpx;
  border-radius: 22rpx;
  background: #f3f3f3;
  color: #8a8a8a;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  flex-shrink: 0;
  box-sizing: border-box;
}

.problem-reaction {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #9a9a9a;
}

.problem-reaction + .problem-reaction {
  border-top: 1rpx solid #e5e5e5;
}

.problem-reaction.up.active {
  background: #eefbea;
  color: #46b855;
}

.problem-reaction.down.active {
  background: #fff4e8;
  color: #e58b2a;
}

.problem-reaction-icon {
  display: block;
  font-size: 25rpx;
  line-height: 1;
}

.problem-reaction-count {
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1;
}
