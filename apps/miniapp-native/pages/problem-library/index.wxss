.library-hero {
  background:
    radial-gradient(circle at 90% 10%, rgba(20, 184, 166, 0.16), transparent 30%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(241, 247, 255, 0.96) 100%);
}

.library-search {
  margin-top: 22rpx;
}

.problem-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.problem-card {
  display: flex;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 24rpx;
  background: #fbfdff;
}

.interactive-card {
  transform: scale(1);
  transition: transform 0.16s ease, opacity 0.16s ease, box-shadow 0.16s ease;
}

.interactive-card-hover {
  transform: scale(0.988);
  opacity: 0.97;
}

.problem-thumb {
  width: 180rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: #e8eef6;
  flex-shrink: 0;
  overflow: hidden;
}

.problem-thumb-fallback {
  background:
    radial-gradient(circle at 30% 25%, rgba(56, 189, 248, 0.32), transparent 34%),
    linear-gradient(135deg, #dbeafe 0%, #ccfbf1 100%);
}

.problem-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.problem-head {
  align-items: flex-start;
}

.problem-title {
  flex: 1;
  color: #08203d;
  font-size: 29rpx;
  font-weight: 780;
  line-height: 1.45;
}

.problem-subtitle {
  margin-top: 8rpx;
  line-height: 1.5;
}

.problem-action {
  margin-top: auto;
  padding-top: 12rpx;
  color: #1d4ed8;
  font-size: 23rpx;
  font-weight: 700;
}
