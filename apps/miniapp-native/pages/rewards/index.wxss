.rewards-page {
  gap: 24rpx;
}

.rewards-hero {
  border-radius: 30rpx;
  background: #ffffff;
}

.points-hero {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #f4f4f4;
}

.points-hero-label {
  display: block;
  color: #777777;
  font-size: 24rpx;
}

.points-hero-value {
  display: block;
  margin-top: 10rpx;
  color: #1f2329;
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1;
}

.reward-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.reward-tab {
  flex: 1;
  min-width: 0;
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f2f3;
  color: #777777;
  font-size: 25rpx;
  font-weight: 850;
  text-align: center;
  border: 0;
}

.reward-tab.active {
  color: #ffffff;
  background: #46b855;
}

.reward-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 22rpx;
}

.reward-card {
  padding: 0;
  overflow: hidden;
  border-radius: 28rpx;
  background: #ffffff;
}

.reward-image {
  width: 100%;
  height: 190rpx;
  background: #eeeeee;
}

.reward-image-fallback {
  background: linear-gradient(135deg, #e8f8e9 0%, #f4f4f4 100%);
}

.reward-title {
  display: block;
  padding: 18rpx 16rpx 0;
  color: #1f2329;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.4;
  min-height: 72rpx;
}

.reward-meta-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 16rpx 0;
}

.reward-meta {
  color: #8a8a8a;
  font-size: 21rpx;
  line-height: 1.45;
}

.reward-btn {
  margin: 16rpx 16rpx 18rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 20rpx;
  background: #46b855;
  font-size: 24rpx;
}

.address-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.38);
}

.address-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 16rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 34rpx 34rpx 0 0;
  background: #f6f6f6;
  box-sizing: border-box;
}

.address-sheet-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: #d8d8d8;
}

.address-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.address-sheet-title-wrap {
  min-width: 0;
  flex: 1;
}

.address-sheet-title {
  display: block;
  color: #1f2329;
  font-size: 34rpx;
  font-weight: 900;
}

.address-sheet-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 1.5;
}

.address-sheet-close {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  border-radius: 50%;
  text-align: center;
  color: #777777;
  font-size: 42rpx;
  background: #ffffff;
}

.address-sheet-list {
  max-height: 52vh;
  margin-top: 24rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.address-sheet-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx solid transparent;
}

.address-sheet-item.active {
  border-color: #46b855;
  background: #eefbea;
}

.address-select-dot {
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 3rpx solid #b8dcbc;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  background: #ffffff;
}

.address-select-dot-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #46b855;
}

.address-sheet-copy {
  min-width: 0;
  flex: 1;
}

.address-sheet-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.address-sheet-name {
  color: #1f2329;
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.45;
}

.address-default-tag {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: #eef8ef;
  color: #46b855;
  font-size: 20rpx;
  font-weight: 800;
}

.address-sheet-detail {
  display: block;
  margin-top: 8rpx;
  color: #777777;
  font-size: 24rpx;
  line-height: 1.6;
}

.address-sheet-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.address-manage-btn,
.address-confirm-btn {
  flex: 1;
  margin: 0;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
}
