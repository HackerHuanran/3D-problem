.rewards-page {
  gap: 22rpx;
}

.rewards-hero {
  background:
    radial-gradient(circle at 14% 10%, rgba(20, 184, 166, 0.18), transparent 34%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(241, 248, 255, 0.94) 100%);
}

.points-hero {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.08), rgba(20, 184, 166, 0.12));
}

.points-hero-label {
  display: block;
  color: #5d7692;
  font-size: 23rpx;
}

.points-hero-value {
  display: block;
  margin-top: 10rpx;
  color: #08203d;
  font-size: 58rpx;
  font-weight: 860;
}

.reward-card {
  padding: 0;
  overflow: hidden;
}

.reward-image {
  width: 100%;
  height: 240rpx;
  background: #e8eef6;
}

.reward-image-fallback {
  background: linear-gradient(135deg, #dbeafe 0%, #d1fae5 100%);
}

.reward-title {
  display: block;
  padding: 22rpx 22rpx 0;
  color: #08203d;
  font-size: 28rpx;
  font-weight: 760;
}

.reward-meta-row {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 22rpx 0;
}

.reward-meta {
  color: #57708f;
  font-size: 24rpx;
  line-height: 1.6;
}

.reward-btn {
  margin: 20rpx 22rpx 22rpx;
  height: 78rpx;
  line-height: 78rpx;
}

.address-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: flex-end;
  background: rgba(8, 32, 61, 0.42);
}

.address-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 16rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #f8fbff;
  box-sizing: border-box;
  box-shadow: 0 -20rpx 56rpx rgba(8, 32, 61, 0.18);
}

.address-sheet-handle {
  width: 78rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 999rpx;
  background: rgba(87, 112, 143, 0.22);
}

.address-sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.address-sheet-title-wrap {
  min-width: 0;
  flex: 1;
}

.address-sheet-title {
  display: block;
  color: #08203d;
  font-size: 34rpx;
  font-weight: 820;
}

.address-sheet-subtitle {
  display: block;
  margin-top: 8rpx;
  color: #6b86a8;
  font-size: 24rpx;
  line-height: 1.5;
}

.address-sheet-close {
  width: 60rpx;
  height: 60rpx;
  line-height: 56rpx;
  border-radius: 50%;
  text-align: center;
  color: #57708f;
  font-size: 42rpx;
  background: #ffffff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.address-sheet-list {
  max-height: 52vh;
  margin-top: 24rpx;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.address-sheet-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 2rpx solid rgba(37, 99, 235, 0.08);
  box-shadow: 0 10rpx 26rpx rgba(13, 41, 87, 0.05);
}

.address-sheet-item.active {
  border-color: rgba(29, 78, 216, 0.72);
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.07), rgba(20, 184, 166, 0.08));
}

.address-select-dot {
  width: 34rpx;
  height: 34rpx;
  margin-top: 4rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(29, 78, 216, 0.36);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  background: #ffffff;
}

.address-select-dot-inner {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
}

.address-sheet-copy {
  min-width: 0;
  flex: 1;
}

.address-sheet-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.address-sheet-name {
  color: #08203d;
  font-size: 28rpx;
  font-weight: 760;
  line-height: 1.45;
}

.address-default-tag {
  flex-shrink: 0;
  padding: 5rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(20, 184, 166, 0.12);
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 760;
}

.address-sheet-detail {
  display: block;
  margin-top: 8rpx;
  color: #57708f;
  font-size: 24rpx;
  line-height: 1.6;
}

.address-sheet-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 24rpx;
}

.address-manage-btn,
.address-confirm-btn {
  flex: 1;
  margin: 0;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 20rpx;
  box-sizing: border-box;
}
