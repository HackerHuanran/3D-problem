<view class="page">
  <view class="hero-card">
    <text class="title">{{pageTitle}}</text>
    <text class="subtitle">{{problemId ? '当前为管理员修改正式问题，保存后会直接更新问题库。' : '提交后会进入待审核，审核通过后会展示到问题库里。每日前 5 次通过审核的有效分享可获得积分。'}}</text>
  </view>

  <view class="panel">
    <text class="meta">问题标题</text>
    <input class="text-input" placeholder="例如：PLA 打印时边角翘起" value="{{title}}" bindinput="onTitleInput" />

    <text class="meta" style="margin-top: 22rpx; display:block;">问题图片</text>
    <view class="upload-box" bindtap="chooseImage">
      <image wx:if="{{coverImage}}" class="upload-image" src="{{coverImage}}" mode="aspectFill"></image>
      <view wx:else>
        <text class="upload-title">点击上传问题图片</text>
        <text class="upload-desc">建议上传打印失败位置的清晰照片</text>
      </view>
    </view>

    <text class="meta" style="margin-top: 22rpx; display:block;">问题描述</text>
    <textarea class="textarea" placeholder="请描述现象、材料、机型和出现场景，例如：使用 PLA，热床 60°C，第一层边角开始翘起。" value="{{description}}" bindinput="onDescriptionInput"></textarea>

    <view class="step-header">
      <view>
        <text class="meta">常见原因</text>
        <text class="step-header-note">可补充多个原因</text>
      </view>
      <view class="step-add-btn" bindtap="addCause">
        <text class="step-add-icon">+</text>
        <text class="step-add-text">添加原因</text>
      </view>
    </view>

    <view class="list" style="margin-top: 18rpx;">
      <view wx:for="{{causes}}" wx:key="index" class="step-item">
        <view class="row">
          <text class="meta">原因 {{index + 1}}</text>
          <button wx:if="{{causes.length > 1}}" class="btn-danger" size="mini" data-index="{{index}}" bindtap="removeCause">删除</button>
        </view>
        <textarea class="textarea" placeholder="填写一个常见原因" value="{{item.text}}" data-index="{{index}}" bindinput="onCauseInput"></textarea>
      </view>
    </view>

    <view class="step-header">
      <view>
        <text class="meta">解决办法步骤</text>
        <text class="step-header-note">可以持续添加更多步骤</text>
      </view>
      <view class="step-add-btn" bindtap="addStep">
        <text class="step-add-icon">+</text>
        <text class="step-add-text">添加步骤</text>
      </view>
    </view>

    <view class="list" style="margin-top: 18rpx;">
      <view wx:for="{{steps}}" wx:key="index" class="step-item">
        <view class="row">
          <text class="meta">步骤 {{index + 1}}</text>
          <button wx:if="{{steps.length > 1}}" class="btn-danger" size="mini" data-index="{{index}}" bindtap="removeStep">删除</button>
        </view>
        <textarea class="textarea" placeholder="填写该步骤的处理方法" value="{{item.text}}" data-index="{{index}}" bindinput="onStepInput"></textarea>
        <view class="step-image-box {{item.displayImage || item.image ? 'has-image' : ''}}" data-index="{{index}}" bindtap="chooseStepImage">
          <image wx:if="{{item.displayImage || item.image}}" class="step-image-preview" src="{{item.displayImage || item.image}}" mode="aspectFill"></image>
          <view wx:else class="step-image-empty">
            <text class="step-image-title">上传步骤图片</text>
            <text class="step-image-desc">每个步骤最多 1 张，可选</text>
          </view>
        </view>
        <text wx:if="{{item.displayImage || item.image}}" class="step-image-remove" data-index="{{index}}" catchtap="removeStepImage">删除步骤图片</text>
      </view>
    </view>
  </view>

  <button class="btn-primary" bindtap="submit">{{problemId || submissionId ? '保存修改' : '提交问题'}}</button>
</view>
