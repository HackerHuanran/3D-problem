.upload-box {
  margin-top: 14rpx;
  min-height: 260rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(circle at 20% 15%, rgba(56, 189, 248, 0.2), transparent 34%),
    linear-gradient(135deg, rgba(29, 78, 216, 0.08) 0%, rgba(20, 184, 166, 0.08) 100%);
  border: 1rpx dashed rgba(29, 78, 216, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.upload-title {
  color: #1d4ed8;
  font-size: 30rpx;
  font-weight: 800;
}

.upload-desc {
  margin-top: 10rpx;
  color: #6b86a8;
  font-size: 23rpx;
}

.upload-image {
  width: 100%;
  height: 320rpx;
  border-radius: 22rpx;
}

.textarea {
  margin-top: 14rpx;
  width: 100%;
  min-height: 190rpx;
  padding: 22rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
  font-size: 28rpx;
  color: #08203d;
}

.step-header {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.step-header-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b86a8;
}

.step-add-btn {
  flex-shrink: 0;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.1) 0%, rgba(20, 184, 166, 0.12) 100%);
  border: 1rpx solid rgba(29, 78, 216, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  box-sizing: border-box;
}

.step-add-icon {
  color: #1d4ed8;
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1;
}

.step-add-text {
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.step-item {
  padding: 20rpx;
  border-radius: 22rpx;
  background: #fbfdff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.step-image-box {
  margin-top: 16rpx;
  min-height: 150rpx;
  border-radius: 20rpx;
  border: 1rpx dashed rgba(29, 78, 216, 0.18);
  background:
    radial-gradient(circle at 18% 18%, rgba(56, 189, 248, 0.16), transparent 34%),
    linear-gradient(135deg, rgba(29, 78, 216, 0.06), rgba(20, 184, 166, 0.08));
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-align: center;
}

.step-image-box.has-image {
  min-height: 220rpx;
  border-style: solid;
  background: #e8eef6;
}

.step-image-preview {
  width: 100%;
  height: 220rpx;
  display: block;
}

.step-image-title {
  display: block;
  color: #1d4ed8;
  font-size: 26rpx;
  font-weight: 800;
}

.step-image-desc {
  display: block;
  margin-top: 8rpx;
  color: #6b86a8;
  font-size: 22rpx;
}

.step-image-remove {
  display: inline-flex;
  margin-top: 12rpx;
  color: #dc2626;
  font-size: 24rpx;
  font-weight: 700;
}

.edit-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(29, 78, 216, 0.1);
  color: #1d4ed8;
  font-size: 24rpx;
}

.btn-primary {
  margin-top: 24rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}
