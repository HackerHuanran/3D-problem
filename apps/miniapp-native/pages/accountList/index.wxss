.account-list-page {
  gap: 22rpx;
}

.content-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.content-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fbfdff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.content-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.content-title {
  flex: 1;
  color: #08203d;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.5;
}

.content-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(29, 78, 216, 0.08);
  color: #1d4ed8;
  font-size: 22rpx;
}

.content-desc {
  display: block;
  margin-top: 12rpx;
  color: #6b86a8;
  font-size: 24rpx;
  line-height: 1.7;
}

.content-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
}

.content-meta {
  color: #8da0b7;
  font-size: 22rpx;
}

.edit-button {
  margin: 0;
  padding: 0 22rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.edit-button::after {
  border: none;
}

.empty-box {
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(37, 99, 235, 0.08);
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.07);
}

.loading-title {
  display: block;
  color: #08203d;
  font-size: 30rpx;
  font-weight: 750;
}

.loading-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #6b86a8;
  font-size: 24rpx;
  line-height: 1.7;
}
