.services-page {
  gap: 22rpx;
}

.services-hero {
  padding: 34rpx 28rpx 28rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 12% 12%, rgba(96, 165, 250, 0.22), transparent 34%),
    radial-gradient(circle at 88% 0%, rgba(20, 184, 166, 0.2), transparent 30%),
    linear-gradient(135deg, #08111f 0%, #10213d 56%, #0b3f46 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 24rpx 60rpx rgba(7, 21, 41, 0.18);
}

.services-hero .title {
  color: #ffffff;
}

.service-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.service-card {
  padding: 24rpx;
}

.service-top {
  display: flex;
  gap: 18rpx;
  align-items: stretch;
}

.service-cover {
  width: 212rpx;
  height: 212rpx;
  border-radius: 22rpx;
  background: #e8eef6;
  flex-shrink: 0;
  display: block;
  overflow: hidden;
}

.service-cover-fallback {
  background:
    radial-gradient(circle at 30% 25%, rgba(56, 189, 248, 0.34), transparent 34%),
    linear-gradient(135deg, #dbeafe 0%, #ccfbf1 100%);
}

.service-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.service-brand {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.service-name {
  flex: 1;
  color: #08203d;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.4;
}

.service-badge {
  flex-shrink: 0;
}

.service-model {
  color: #2563eb;
  font-size: 24rpx;
  line-height: 1.6;
}

.service-brief {
  color: #57708f;
  font-size: 24rpx;
  line-height: 1.7;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.service-footer {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid rgba(148, 163, 184, 0.14);
}

.service-meta {
  color: #6b86a8;
  font-size: 22rpx;
}

.service-link {
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 700;
}
