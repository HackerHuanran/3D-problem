.services-page {
  gap: 24rpx;
}

.services-hero {
  padding: 30rpx;
  border-radius: 30rpx;
  background: #ffffff;
}

.services-hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.services-hero-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.services-hero .meta {
  color: #46b855;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.settle-btn {
  flex-shrink: 0;
  min-width: 136rpx;
  height: 66rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #46b855;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 850;
  border: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.settle-btn::after {
  border: 0;
}

.panel {
  padding: 28rpx;
}

.service-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.service-card {
  padding: 0 0 20rpx;
  border-radius: 0;
  background: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
  box-shadow: none;
}

.service-card:last-child {
  border-bottom: 0;
}

.interactive-card {
  transform: scale(1);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.interactive-card-hover {
  transform: scale(0.988);
  opacity: 0.95;
}

.service-top {
  display: flex;
  gap: 18rpx;
  align-items: stretch;
}

.service-cover {
  width: 198rpx;
  height: 198rpx;
  border-radius: 24rpx;
  background: #eeeeee;
  flex-shrink: 0;
  display: block;
  overflow: hidden;
}

.service-cover-fallback {
  background: linear-gradient(135deg, #e8f8e9 0%, #f4f4f4 100%);
}

.service-main {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.service-brand {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.service-name {
  flex: 1;
  color: #1f2329;
  font-size: 31rpx;
  font-weight: 850;
  line-height: 1.4;
}

.service-badge {
  flex-shrink: 0;
  background: #eef8ef;
  color: #46b855;
}

.service-model {
  color: #46b855;
  font-size: 24rpx;
  line-height: 1.55;
  font-weight: 700;
}

.service-brief {
  color: #8a8a8a;
  font-size: 24rpx;
  line-height: 1.65;
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.service-footer {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.service-meta {
  color: #8a8a8a;
  font-size: 22rpx;
}

.service-link {
  color: #46b855;
  font-size: 24rpx;
  font-weight: 800;
}
