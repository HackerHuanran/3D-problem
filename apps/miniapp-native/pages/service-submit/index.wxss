.service-submit-page {
  gap: 22rpx;
}

.service-submit-hero {
  padding: 34rpx 28rpx 28rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 12% 12%, rgba(96, 165, 250, 0.22), transparent 34%),
    radial-gradient(circle at 88% 0%, rgba(20, 184, 166, 0.2), transparent 30%),
    linear-gradient(135deg, #08111f 0%, #10213d 56%, #0b3f46 100%);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  box-shadow: 0 24rpx 60rpx rgba(7, 21, 41, 0.18);
}

.service-submit-hero .title {
  color: #ffffff;
}

.service-form {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.service-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.service-field-label {
  color: #08203d;
  font-size: 27rpx;
  font-weight: 800;
}

.field-tip {
  color: #6b86a8;
  font-size: 23rpx;
  line-height: 1.6;
}

.text-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
  color: #08203d;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
  color: #08203d;
  font-size: 28rpx;
  line-height: 1.7;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.image-card,
.image-picker {
  position: relative;
  min-height: 176rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #e8eef6;
}

.image-preview {
  width: 100%;
  height: 176rpx;
  display: block;
}

.image-remove {
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  padding: 7rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(8, 17, 31, 0.72);
  color: #ffffff;
  font-size: 21rpx;
}

.image-picker,
.qr-placeholder {
  border: 1rpx dashed rgba(29, 78, 216, 0.22);
  background:
    radial-gradient(circle at 20% 15%, rgba(56, 189, 248, 0.18), transparent 34%),
    linear-gradient(135deg, rgba(29, 78, 216, 0.06), rgba(20, 184, 166, 0.08));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.image-picker-plus {
  color: #1d4ed8;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1;
}

.image-picker-text {
  color: #1d4ed8;
  font-size: 23rpx;
  font-weight: 780;
}

.qr-picker {
  width: 100%;
  min-height: 320rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #e8eef6;
}

.qr-preview,
.qr-placeholder {
  width: 100%;
  height: 320rpx;
}

.form-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.form-link {
  color: #1d4ed8;
  font-size: 25rpx;
  font-weight: 800;
}

.form-link.danger {
  color: #dc2626;
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
}
