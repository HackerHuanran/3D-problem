<view class="page reward-orders-page">
  <view wx:if="{{!currentUser}}" class="hero-card">
    <text class="title">我的兑换记录</text>
    <text class="subtitle">请先登录后再查看兑换记录。</text>
  </view>

  <block wx:if="{{currentUser}}">
    <view class="hero-card">
      <text class="title">我的兑换记录</text>
      <text class="subtitle">这里会展示你用积分兑换耗材的记录和处理状态。</text>
    </view>

    <view wx:if="{{orders.length}}" class="panel">
      <view class="order-list">
        <view wx:for="{{orders}}" wx:key="id" class="card order-card">
          <image wx:if="{{item.goodsImageDisplay}}" class="order-image" src="{{item.goodsImageDisplay}}" mode="aspectFill"></image>
          <view wx:else class="order-image order-image-fallback"></view>
          <view class="order-copy">
            <view class="row">
              <text class="order-title">{{item.goodsName}}</text>
              <text class="badge">{{item.statusText}}</text>
            </view>
            <text class="order-meta">消耗积分：{{item.pointsCost}}</text>
            <text class="order-meta">{{item.addressText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:else class="empty-box">
      <text class="subtitle">你还没有兑换记录。</text>
    </view>
  </block>
</view>
