<view class="account-page">
  <view wx:if="{{currentUser}}" class="hero">
    <view class="hero-bg hero-bg-left"></view>
    <view class="hero-bg hero-bg-right"></view>
    <view class="hero-head" bindtap="openProfileEdit">
      <image wx:if="{{currentUser.hasAvatarImage && !avatarLoadFailed}}" class="hero-avatar" src="{{currentUser.avatarSrc}}" mode="aspectFill" bindload="onAvatarLoad" binderror="onAvatarLoadError"></image>
      <view wx:else class="hero-avatar hero-avatar-fallback">
        <text class="hero-avatar-text">{{currentUser.avatarText || '微'}}</text>
      </view>
      <view class="hero-copy">
        <text class="hero-name">{{currentUser.displayName || '微信用户'}}</text>
        <text class="hero-tag">别塌了模型用户</text>
      </view>
      <view class="hero-edit-pill">
        <text>编辑</text>
      </view>
    </view>

    <view class="hero-highlight">
      <view class="hero-points-card">
        <view class="hero-points-copy">
          <text class="hero-points-label">当前积分</text>
          <view class="hero-points-number-row">
            <text class="hero-points-value">{{currentUser.points || currentProfile.points || 0}}</text>
            <text class="hero-points-unit">分</text>
          </view>
          <text class="hero-points-hint">可用于兑换耗材奖励</text>
        </view>
        <view class="hero-points-visual" aria-hidden="true">
          <view class="points-coin coin-back"></view>
          <view class="points-coin coin-front"></view>
          <view class="points-spark spark-a"></view>
          <view class="points-spark spark-b"></view>
        </view>
      </view>
      <text class="hero-highlight-desc" wx:if="{{currentUser.gender}}">
        {{currentUser.gender ? ('性别 ' + (currentUser.gender === 'male' ? '男' : currentUser.gender === 'female' ? '女' : '保密')) : ''}}
      </text>
    </view>
  </view>

  <view wx:if="{{!currentUser}}" class="hero guest-hero">
    <view class="hero-bg hero-bg-left"></view>
    <view class="hero-bg hero-bg-right"></view>
    <text class="guest-title">登录后同步你的问题记录</text>
    <text class="guest-subtitle">登录后可查看收藏、最近浏览、投稿记录和管理入口。</text>
    <view class="guest-legal">
      <view class="guest-legal-check" bindtap="toggleLegalAccepted">
        <view class="guest-legal-box {{legalAccepted ? 'checked' : ''}}">
          <text wx:if="{{legalAccepted}}" class="guest-legal-box-icon">✓</text>
        </view>
        <text class="guest-legal-text">我已阅读并同意</text>
      </view>
      <text class="guest-legal-link" bindtap="openLegal">《用户服务协议》与《隐私政策》</text>
    </view>
    <button class="btn-primary guest-btn" loading="{{loading}}" bindtap="loginWechat">微信登录</button>
  </view>

  <view wx:if="{{currentUser}}" class="stats-strip">
    <view class="stats-item stats-item-link" bindtap="openFavorites">
      <text class="stats-value">{{favoriteCount}}</text>
      <text class="stats-label">收藏</text>
    </view>
    <view class="stats-item stats-item-link" bindtap="openHistory">
      <text class="stats-value">{{historyCount}}</text>
      <text class="stats-label">浏览</text>
    </view>
    <view class="stats-item stats-item-link" bindtap="openSubmissions">
      <text class="stats-value">{{submissionCount}}</text>
      <text class="stats-label">投稿</text>
    </view>
  </view>

  <view wx:if="{{currentUser}}" class="menu-card">
    <view class="menu-cell" bindtap="openRewards">
      <view class="menu-icon menu-icon-reward">
        <view class="icon-gift">
          <view class="icon-gift-bow"></view>
          <view class="icon-gift-box"></view>
        </view>
      </view>
      <view class="menu-copy">
        <text class="menu-title">积分兑换</text>
        <text class="menu-desc">用已获得的积分兑换耗材商品</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-cell" bindtap="openRewardOrders">
      <view class="menu-icon menu-icon-orders">
        <view class="icon-receipt">
          <view class="icon-receipt-line"></view>
          <view class="icon-receipt-line short"></view>
        </view>
      </view>
      <view class="menu-copy">
        <text class="menu-title">我的兑换记录</text>
        <text class="menu-desc">查看积分兑换耗材的处理状态</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-cell" bindtap="openAddresses">
      <view class="menu-icon menu-icon-address">
        <view class="icon-pin"></view>
      </view>
      <view class="menu-copy">
        <text class="menu-title">地址管理</text>
        <text class="menu-desc">维护积分兑换收货地址与默认地址</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-cell" bindtap="openLegal">
      <view class="menu-icon menu-icon-legal">
        <view class="icon-shield"></view>
      </view>
      <view class="menu-copy">
        <text class="menu-title">用户服务协议与隐私政策</text>
        <text class="menu-desc">查看平台服务规则与个人信息处理说明</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view class="menu-cell" bindtap="openFeedback">
      <view class="menu-icon menu-icon-feedback">
        <view class="icon-message"></view>
      </view>
      <view class="menu-copy">
        <text class="menu-title">反馈与建议</text>
        <text class="menu-desc">填写使用建议或问题反馈，只有管理员可以查看</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>
    <view wx:if="{{isAdmin}}" class="menu-cell" bindtap="openAdmin">
      <view class="menu-icon menu-icon-admin">
        <view class="icon-gear">
          <view class="icon-gear-core"></view>
        </view>
      </view>
      <view class="menu-copy">
        <text class="menu-title">管理后台</text>
        <text class="menu-desc">审核投稿、管理图片、维护内容</text>
      </view>
      <text wx:if="{{adminNoticeCount > 0}}" class="menu-badge">{{adminNoticeText}}</text>
      <text class="menu-arrow">›</text>
    </view>
    <view wx:if="{{isAdmin}}" class="menu-divider"></view>
    <view class="menu-cell" bindtap="logout">
      <view class="menu-icon menu-icon-logout">
        <view class="icon-logout">
          <view class="icon-logout-arrow"></view>
        </view>
      </view>
      <view class="menu-copy">
        <text class="menu-title danger">退出登录</text>
        <text class="menu-desc">退出后回到游客状态</text>
      </view>
      <text class="menu-arrow danger">›</text>
    </view>
  </view>
</view>
