.account-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  background:
    radial-gradient(circle at top left, rgba(29, 78, 216, 0.1), transparent 30%),
    linear-gradient(180deg, #f4f9ff 0%, #edf4ff 100%);
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 28rpx 28rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 12% 10%, rgba(56, 189, 248, 0.25), transparent 34%),
    linear-gradient(135deg, #071529 0%, #10213d 58%, #0e3a4d 100%);
  box-shadow: 0 24rpx 60rpx rgba(7, 21, 41, 0.18);
}

.hero-bg {
  position: absolute;
  border-radius: 50%;
  opacity: 0.22;
  pointer-events: none;
}

.hero-bg-left {
  width: 300rpx;
  height: 300rpx;
  left: -120rpx;
  top: -130rpx;
  background: radial-gradient(circle, rgba(125, 211, 252, 0.92) 0%, rgba(125, 211, 252, 0) 70%);
}

.hero-bg-right {
  width: 280rpx;
  height: 280rpx;
  right: -100rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(45, 212, 191, 0.8) 0%, rgba(45, 212, 191, 0) 72%);
}

.hero-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.hero-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 4rpx solid rgba(255, 255, 255, 0.26);
  flex-shrink: 0;
}

.hero-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(125, 211, 252, 0.42), rgba(20, 184, 166, 0.26));
}

.hero-avatar-text {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-name {
  display: block;
  color: #f8fbff;
  font-size: 44rpx;
  font-weight: 850;
  line-height: 1.2;
}

.hero-tag {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(221, 235, 255, 0.82);
  font-size: 22rpx;
}

.hero-edit-pill {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: #ccfbf1;
  font-size: 23rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-highlight {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.hero-highlight-label {
  display: block;
  font-size: 29rpx;
  font-weight: 750;
}

.hero-highlight-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: rgba(221, 235, 255, 0.72);
}

.guest-hero {
  padding: 42rpx 32rpx 36rpx;
}

.guest-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #f8fbff;
  font-size: 40rpx;
  font-weight: 850;
}

.guest-subtitle {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 14rpx;
  color: rgba(221, 235, 255, 0.76);
  font-size: 26rpx;
  line-height: 1.7;
}

.guest-btn {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
}

.guest-legal {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.guest-legal-text {
  color: rgba(221, 235, 255, 0.68);
  font-size: 22rpx;
}

.guest-legal-link {
  color: #dbeafe;
  font-size: 22rpx;
  text-decoration: underline;
}

.stats-strip {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 12rpx 34rpx rgba(13, 41, 87, 0.06);
}

.stats-value {
  color: #08203d;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.2;
}

.stats-label {
  margin-top: 8rpx;
  color: #6b86a8;
  font-size: 23rpx;
}

.quick-card,
.content-card,
.menu-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.07);
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title {
  color: #08203d;
  font-size: 34rpx;
  font-weight: 800;
}

.section-note {
  color: #8da0b7;
  font-size: 22rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.quick-item {
  padding: 22rpx 16rpx;
  border-radius: 22rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.quick-item.active {
  background: linear-gradient(135deg, #1d4ed8 0%, #14b8a6 100%);
  box-shadow: 0 14rpx 34rpx rgba(29, 78, 216, 0.18);
}

.quick-item.active .quick-name,
.quick-item.active .quick-meta {
  color: #ffffff;
}

.quick-item-link {
  background: linear-gradient(135deg, rgba(29, 78, 216, 0.09), rgba(20, 184, 166, 0.09));
}

.quick-name {
  display: block;
  color: #08203d;
  font-size: 26rpx;
  font-weight: 750;
}

.quick-meta {
  display: block;
  margin-top: 8rpx;
  color: #7890aa;
  font-size: 22rpx;
}

.loading-box,
.empty-box {
  margin-top: 22rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #f8fbff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.loading-title {
  display: block;
  color: #08203d;
  font-size: 30rpx;
  font-weight: 750;
}

.loading-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #6b86a8;
  font-size: 24rpx;
  line-height: 1.7;
}

.content-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.content-item {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #fbfdff;
  border: 1rpx solid rgba(37, 99, 235, 0.08);
}

.content-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.content-title {
  flex: 1;
  color: #08203d;
  font-size: 29rpx;
  font-weight: 750;
  line-height: 1.5;
}

.content-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(29, 78, 216, 0.08);
  color: #1d4ed8;
  font-size: 22rpx;
}

.content-desc {
  display: block;
  margin-top: 12rpx;
  color: #6b86a8;
  font-size: 24rpx;
  line-height: 1.7;
}

.content-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 16rpx;
}

.content-meta {
  color: #8da0b7;
  font-size: 22rpx;
}

.edit-button {
  margin: 0;
  padding: 0 22rpx;
  height: 58rpx;
  line-height: 58rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.edit-button::after {
  border: none;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx 0;
}

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-title {
  display: block;
  color: #08203d;
  font-size: 29rpx;
  font-weight: 750;
}

.menu-title.danger {
  color: #dc2626;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  color: #8398b0;
  font-size: 23rpx;
}

.menu-arrow {
  color: #a8b3c3;
  font-size: 36rpx;
  line-height: 1;
}

.menu-arrow.danger {
  color: #ef4444;
}

.menu-divider {
  height: 1rpx;
  background: rgba(30, 44, 68, 0.08);
}
