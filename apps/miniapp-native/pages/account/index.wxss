.account-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
  background:
    radial-gradient(circle at top left, rgba(29, 78, 216, 0.1), transparent 30%),
    linear-gradient(180deg, #f4f9ff 0%, #edf4ff 100%);
  box-sizing: border-box;
}

.hero {
  position: relative;
  overflow: hidden;
  padding: 34rpx 28rpx 28rpx;
  border-radius: 30rpx;
  background:
    radial-gradient(circle at 12% 10%, rgba(56, 189, 248, 0.25), transparent 34%),
    linear-gradient(135deg, #071529 0%, #10213d 58%, #0e3a4d 100%);
  box-shadow: 0 24rpx 60rpx rgba(7, 21, 41, 0.18);
}

.hero-bg {
  position: absolute;
  border-radius: 50%;
  opacity: 0.22;
  pointer-events: none;
}

.hero-bg-left {
  width: 300rpx;
  height: 300rpx;
  left: -120rpx;
  top: -130rpx;
  background: radial-gradient(circle, rgba(125, 211, 252, 0.92) 0%, rgba(125, 211, 252, 0) 70%);
}

.hero-bg-right {
  width: 280rpx;
  height: 280rpx;
  right: -100rpx;
  bottom: -120rpx;
  background: radial-gradient(circle, rgba(45, 212, 191, 0.8) 0%, rgba(45, 212, 191, 0) 72%);
}

.hero-head {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.hero-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 4rpx solid rgba(255, 255, 255, 0.26);
  flex-shrink: 0;
}

.hero-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(125, 211, 252, 0.42), rgba(20, 184, 166, 0.26));
}

.hero-avatar-text {
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.hero-name {
  display: block;
  color: #f8fbff;
  font-size: 44rpx;
  font-weight: 850;
  line-height: 1.2;
}

.hero-tag {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(221, 235, 255, 0.82);
  font-size: 22rpx;
}

.hero-edit-pill {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  color: #ccfbf1;
  font-size: 23rpx;
  font-weight: 750;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-highlight {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  color: #ffffff;
}

.hero-highlight-label {
  display: block;
  font-size: 29rpx;
  font-weight: 750;
}

.hero-highlight-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 1.65;
  color: rgba(221, 235, 255, 0.72);
}

.guest-hero {
  padding: 42rpx 32rpx 36rpx;
}

.guest-title {
  position: relative;
  z-index: 1;
  display: block;
  color: #f8fbff;
  font-size: 40rpx;
  font-weight: 850;
}

.guest-subtitle {
  position: relative;
  z-index: 1;
  display: block;
  margin-top: 14rpx;
  color: rgba(221, 235, 255, 0.76);
  font-size: 26rpx;
  line-height: 1.7;
}

.guest-btn {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  height: 84rpx;
  line-height: 84rpx;
}

.guest-legal {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.guest-legal-check {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.guest-legal-box {
  width: 28rpx;
  height: 28rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(221, 235, 255, 0.56);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.04);
}

.guest-legal-box.checked {
  background: rgba(94, 234, 212, 0.18);
  border-color: rgba(94, 234, 212, 0.72);
}

.guest-legal-box-icon {
  color: #ccfbf1;
  font-size: 20rpx;
  line-height: 1;
  font-weight: 800;
}

.guest-legal-text {
  color: rgba(221, 235, 255, 0.68);
  font-size: 22rpx;
}

.guest-legal-link {
  color: #dbeafe;
  font-size: 22rpx;
  text-decoration: underline;
}

.stats-strip {
  margin-top: 22rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 12rpx 34rpx rgba(13, 41, 87, 0.06);
}

.stats-item-link {
  transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.stats-item-link:active {
  transform: scale(0.985);
  box-shadow: 0 8rpx 24rpx rgba(13, 41, 87, 0.08);
}

.stats-value {
  color: #08203d;
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.2;
}

.stats-label {
  margin-top: 8rpx;
  color: #6b86a8;
  font-size: 23rpx;
}

.menu-card {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(29, 78, 216, 0.08);
  box-shadow: 0 16rpx 42rpx rgba(13, 41, 87, 0.07);
}

.hero-points-card {
  margin-top: 18rpx;
  min-height: 138rpx;
  padding: 22rpx 24rpx;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 82% 20%, rgba(45, 212, 191, 0.32), transparent 32%),
    radial-gradient(circle at 96% 88%, rgba(59, 130, 246, 0.24), transparent 34%),
    linear-gradient(135deg, rgba(248, 251, 255, 0.2), rgba(148, 163, 184, 0.1));
  border: 1rpx solid rgba(226, 246, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18),
    0 18rpx 38rpx rgba(2, 8, 23, 0.12);
  box-sizing: border-box;
}

.hero-points-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hero-points-label {
  color: rgba(221, 235, 255, 0.72);
  font-size: 22rpx;
  font-weight: 760;
  letter-spacing: 2rpx;
}

.hero-points-number-row {
  margin-top: 8rpx;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.hero-points-value {
  color: #ffffff;
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -2rpx;
  text-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.12);
}

.hero-points-unit {
  padding-bottom: 6rpx;
  color: rgba(221, 235, 255, 0.78);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-points-hint {
  margin-top: 8rpx;
  color: rgba(221, 235, 255, 0.58);
  font-size: 22rpx;
}

.hero-points-visual {
  position: relative;
  width: 128rpx;
  height: 104rpx;
  flex-shrink: 0;
}

.points-coin {
  position: absolute;
  border-radius: 50%;
  background:
    radial-gradient(circle at 34% 28%, #ffffff 0%, rgba(255, 255, 255, 0.5) 12%, transparent 26%),
    linear-gradient(135deg, #fef3c7 0%, #f59e0b 52%, #d97706 100%);
  box-shadow:
    inset -8rpx -8rpx 16rpx rgba(146, 64, 14, 0.24),
    0 14rpx 24rpx rgba(245, 158, 11, 0.26);
}

.points-coin::after {
  content: "";
  position: absolute;
  inset: 16rpx;
  border: 4rpx solid rgba(120, 53, 15, 0.2);
  border-radius: 50%;
}

.coin-back {
  width: 58rpx;
  height: 58rpx;
  left: 8rpx;
  top: 24rpx;
  opacity: 0.78;
}

.coin-front {
  width: 78rpx;
  height: 78rpx;
  right: 6rpx;
  top: 10rpx;
}

.points-spark {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #ccfbf1;
  box-shadow: 0 0 16rpx rgba(204, 251, 241, 0.82);
}

.spark-a {
  right: 12rpx;
  top: 0;
}

.spark-b {
  left: 28rpx;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
}

.menu-card {
  padding: 0 28rpx;
}

.menu-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 28rpx 0;
}

.menu-icon {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  box-shadow: 0 10rpx 22rpx rgba(15, 23, 42, 0.08);
}

.menu-icon-reward {
  background: rgba(37, 99, 235, 0.1);
  color: #2563eb;
}

.menu-icon-orders {
  background: rgba(20, 184, 166, 0.12);
  color: #0f766e;
}

.menu-icon-address {
  background: rgba(245, 158, 11, 0.13);
  color: #d97706;
}

.menu-icon-legal {
  background: rgba(100, 116, 139, 0.12);
  color: #475569;
}

.menu-icon-feedback {
  background: rgba(8, 145, 178, 0.12);
  color: #0891b2;
}

.menu-icon-admin {
  background: rgba(79, 70, 229, 0.12);
  color: #4f46e5;
}

.menu-icon-logout {
  background: rgba(220, 38, 38, 0.1);
  color: #dc2626;
}

.icon-gift {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.icon-gift-box {
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  bottom: 1rpx;
  height: 20rpx;
  border: 4rpx solid currentColor;
  border-radius: 5rpx;
  box-sizing: border-box;
}

.icon-gift-box::before {
  content: "";
  position: absolute;
  left: 50%;
  top: -4rpx;
  bottom: -4rpx;
  width: 4rpx;
  background: currentColor;
  transform: translateX(-50%);
}

.icon-gift-bow {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  top: 0;
  height: 12rpx;
  border-top: 4rpx solid currentColor;
}

.icon-gift-bow::before,
.icon-gift-bow::after {
  content: "";
  position: absolute;
  top: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-gift-bow::before {
  left: 0;
}

.icon-gift-bow::after {
  right: 0;
}

.icon-receipt {
  position: relative;
  width: 29rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.icon-receipt::after {
  content: "";
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: -8rpx;
  height: 12rpx;
  background:
    linear-gradient(135deg, transparent 0 45%, currentColor 46% 58%, transparent 59%) left bottom / 10rpx 10rpx repeat-x;
}

.icon-receipt-line {
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  top: 9rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.icon-receipt-line.short {
  right: 12rpx;
  top: 18rpx;
}

.icon-pin {
  position: relative;
  width: 30rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-radius: 50% 50% 50% 0;
  box-sizing: border-box;
  transform: rotate(-45deg);
}

.icon-pin::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.icon-shield {
  position: relative;
  width: 30rpx;
  height: 34rpx;
  border: 4rpx solid currentColor;
  border-radius: 10rpx 10rpx 14rpx 14rpx;
  box-sizing: border-box;
}

.icon-shield::after {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 7rpx;
  width: 8rpx;
  height: 14rpx;
  border-right: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  transform: rotate(38deg);
}

.icon-message {
  position: relative;
  width: 32rpx;
  height: 26rpx;
  border: 4rpx solid currentColor;
  border-radius: 9rpx;
  box-sizing: border-box;
}

.icon-message::after {
  content: "";
  position: absolute;
  left: 6rpx;
  bottom: -9rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 4rpx solid currentColor;
  border-bottom: 4rpx solid currentColor;
  background: transparent;
  transform: rotate(-25deg);
}

.icon-gear {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  border: 5rpx dotted currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.icon-gear-core {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 10rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-sizing: border-box;
}

.icon-logout {
  position: relative;
  width: 31rpx;
  height: 30rpx;
  border: 4rpx solid currentColor;
  border-right: 0;
  border-radius: 7rpx 0 0 7rpx;
  box-sizing: border-box;
}

.icon-logout-arrow {
  position: absolute;
  right: -10rpx;
  top: 50%;
  width: 20rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translateY(-50%);
}

.icon-logout-arrow::after {
  content: "";
  position: absolute;
  right: -1rpx;
  top: -6rpx;
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid currentColor;
  border-right: 4rpx solid currentColor;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.menu-copy {
  min-width: 0;
  flex: 1;
}

.menu-title {
  display: block;
  color: #08203d;
  font-size: 29rpx;
  font-weight: 750;
}

.menu-title.danger {
  color: #dc2626;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  color: #8398b0;
  font-size: 23rpx;
}

.menu-arrow {
  color: #a8b3c3;
  font-size: 36rpx;
  line-height: 1;
}

.menu-badge {
  min-width: 38rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 38rpx;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(239, 68, 68, 0.26);
  box-sizing: border-box;
}

.menu-arrow.danger {
  color: #ef4444;
}

.menu-divider {
  height: 1rpx;
  background: rgba(30, 44, 68, 0.08);
}

