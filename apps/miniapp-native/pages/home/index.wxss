.home-page {
  gap: 28rpx;
  padding-top: 36rpx;
}

.home-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 4rpx 4rpx 0;
}

.home-title {
  display: block;
  color: #1f2329;
  font-size: 50rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: -1rpx;
}

.home-status-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f18732;
}

.home-status {
  color: #8b8b8b;
  font-size: 26rpx;
  font-weight: 500;
}

.top-tools {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding-top: 4rpx;
}

.top-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  color: #1f2329;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.search-wrap {
  display: flex;
  gap: 16rpx;
  padding: 10rpx;
  border-radius: 30rpx;
  background: #ffffff;
}

.home-search {
  flex: 1;
  height: 78rpx;
  border-radius: 24rpx;
  background: #f4f4f4;
  border: 0;
  font-size: 27rpx;
}

.search-btn {
  min-width: 112rpx;
  height: 78rpx;
  line-height: 78rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 24rpx;
  color: #ffffff;
  background: #46b855;
  font-size: 26rpx;
  font-weight: 800;
}

.search-btn::after {
  border: 0;
}

.notice-card {
  min-height: 108rpx;
  padding: 20rpx 22rpx;
  border-radius: 26rpx;
  background: #eefbea;
  border: 2rpx solid #d6f5d0;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.notice-icon {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  color: #ffffff;
  background: #46b855;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
}

.notice-text {
  flex: 1;
  color: #26352a;
  font-size: 27rpx;
  line-height: 1.55;
  font-weight: 600;
}

.notice-arrow {
  color: #8a8a8a;
  font-size: 58rpx;
  line-height: 1;
}

.section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.module-section-row {
  padding: 0 4rpx;
  margin-bottom: -6rpx;
}

.section-title {
  color: #1f2329;
  font-size: 38rpx;
  font-weight: 900;
}

.section-note {
  color: #8a8a8a;
  font-size: 26rpx;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.module-card {
  position: relative;
  min-height: 172rpx;
  padding: 26rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-sizing: border-box;
  overflow: hidden;
}

.interactive-card {
  transform: scale(1);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.interactive-card-hover {
  transform: scale(0.985);
  opacity: 0.94;
}

.module-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  margin-bottom: 22rpx;
}

.module-green .module-icon {
  color: #ffffff;
  background: #46b855;
}

.module-blue .module-icon {
  color: #ffffff;
  background: #4b7bec;
}

.module-orange .module-icon {
  color: #ffffff;
  background: #f2a65a;
}

.module-purple .module-icon {
  color: #ffffff;
  background: #9b7cf6;
}

.module-title {
  display: block;
  color: #1f2329;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.25;
}

.module-desc {
  display: block;
  margin-top: 10rpx;
  color: #7a7f87;
  font-size: 24rpx;
  line-height: 1.35;
}

.module-arrow {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  color: #8a8a8a;
  font-size: 46rpx;
  line-height: 1;
}

.recent-card {
  padding: 28rpx;
  border-radius: 30rpx;
  background: #ffffff;
}

.recent-list {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.recent-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eeeeee;
}

.recent-item:last-child {
  border-bottom: 0;
}

.recent-image {
  width: 108rpx;
  height: 108rpx;
  border-radius: 22rpx;
  background: #eeeeee;
  flex-shrink: 0;
}

.recent-image-fallback {
  background: linear-gradient(135deg, #e8f8e9 0%, #f4f4f4 100%);
}

.recent-copy {
  min-width: 0;
  flex: 1;
}

.recent-title {
  display: block;
  color: #1f2329;
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
}

.recent-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a8a8a;
  font-size: 23rpx;
  line-height: 1.45;
}
