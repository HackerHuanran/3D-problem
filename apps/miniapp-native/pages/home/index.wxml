<view class="page home-page">
  <view class="home-top">
    <view>
      <text class="home-title">别塌了模型</text>
      <view class="home-status-row">
        <view class="status-dot"></view>
        <text class="home-status">共收录 {{problemCount}} 个打印问题</text>
      </view>
    </view>
    <view class="top-tools">
      <view class="top-icon">⌕</view>
      <view class="top-icon">⌘</view>
    </view>
  </view>

  <view class="search-wrap">
    <input class="search-input home-search" placeholder="搜索翘边、拉丝、堵嘴、层移…" value="{{query}}" bindinput="onQueryInput" confirm-type="search" bindconfirm="searchProblems" />
    <button class="search-btn" hover-class="button-hover" hover-stay-time="70" bindtap="searchProblems">搜索</button>
  </view>

  <view class="notice-card" bindtap="shareProblem">
    <view class="notice-icon">!</view>
    <text class="notice-text">遇到新问题？分享打印问题，审核通过后可获得积分。</text>
    <text class="notice-arrow">›</text>
  </view>

  <view class="section-row module-section-row">
    <text class="section-title">功能入口</text>
    <text class="section-note">{{shareCount || problemCount}} 个分享</text>
  </view>

  <view class="module-grid">
    <view class="module-card module-green interactive-card" hover-class="interactive-card-hover" hover-stay-time="70" data-id="problems" bindtap="openEntry">
      <view class="module-icon">□</view>
      <text class="module-title">问题中心</text>
      <text class="module-desc">{{problemCount}} 个问题</text>
      <text class="module-arrow">›</text>
    </view>

    <view class="module-card module-blue interactive-card" hover-class="interactive-card-hover" hover-stay-time="70" data-id="knowledge" bindtap="openEntry">
      <view class="module-icon">▣</view>
      <text class="module-title">知识库</text>
      <text class="module-desc">{{knowledgeCount}} 个知识</text>
      <text class="module-arrow">›</text>
    </view>

    <view class="module-card module-orange interactive-card" hover-class="interactive-card-hover" hover-stay-time="70" data-id="filament" bindtap="openEntry">
      <view class="module-icon">◒</view>
      <text class="module-title">耗材库</text>
      <text class="module-desc">材料参数</text>
      <text class="module-arrow">›</text>
    </view>

    <view class="module-card module-purple interactive-card" hover-class="interactive-card-hover" hover-stay-time="70" data-id="services" bindtap="openEntry">
      <view class="module-icon">◇</view>
      <text class="module-title">打印服务</text>
      <text class="module-desc">{{serviceCount}} 个服务</text>
      <text class="module-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{recentProblems.length}}" class="recent-card">
    <view class="section-row">
      <text class="section-title">最近浏览</text>
      <text class="section-note">继续上次排查</text>
    </view>

    <view class="recent-list">
      <view wx:for="{{recentProblems}}" wx:key="id" class="recent-item interactive-card" hover-class="interactive-card-hover" hover-stay-time="70" data-problem-id="{{item.problemId}}" bindtap="openRecentProblem">
        <image wx:if="{{(item.thumb_url || item.image_url) && !recentImageErrorMap[item.id || item.problemId]}}" class="recent-image" src="{{item.thumb_url || item.image_url}}" mode="aspectFill" lazy-load="true" data-key="{{item.id || item.problemId}}" binderror="onRecentImageError"></image>
        <view wx:else class="recent-image recent-image-fallback"></view>
        <view class="recent-copy">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-desc">{{item.subtitle}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="recent-card">
    <view class="section-row">
      <text class="section-title">推荐排查</text>
      <text class="section-note">先从常见问题开始</text>
    </view>
    <view class="recent-list">
      <view wx:for="{{featuredProblems}}" wx:key="id" class="recent-item interactive-card" hover-class="interactive-card-hover" hover-stay-time="70" data-problem-id="{{item.id}}" bindtap="openRecentProblem">
        <image wx:if="{{(item.thumb_url || item.image_url) && !recentImageErrorMap[item.id]}}" class="recent-image" src="{{item.thumb_url || item.image_url}}" mode="aspectFill" lazy-load="true" data-key="{{item.id}}" binderror="onRecentImageError"></image>
        <view wx:else class="recent-image recent-image-fallback"></view>
        <view class="recent-copy">
          <text class="recent-title">{{item.title}}</text>
          <text class="recent-desc">{{item.subtitle}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
