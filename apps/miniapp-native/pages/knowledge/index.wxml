<view class="page">
  <view class="hero-card">
    <text class="title">知识库</text>
    <text class="subtitle">这里展示审核通过的打印心得和知识分享。</text>
    <button class="btn-primary knowledge-submit-btn" bindtap="openKnowledgeSubmit">分享心得</button>
  </view>

  <view class="panel">
    <input class="search-input" placeholder="搜索知识点…" value="{{query}}" bindinput="onSearchInput" />
  </view>

  <view wx:if="{{filteredInsights.length}}" class="list">
    <view wx:for="{{filteredInsights}}" wx:key="id" class="card">
      <text class="title" style="font-size: 30rpx;">{{item.title}}</text>
      <text class="subtitle">{{item.subtitle}}</text>
      <view wx:if="{{item.effectThumbImages.length}}" class="knowledge-effect-row">
        <image wx:for="{{item.effectThumbImages}}" wx:key="index" class="knowledge-effect-image" src="{{item}}" mode="aspectFill" lazy-load="true"></image>
      </view>
    </view>
  </view>

  <view wx:elif="{{!loadingInsights}}" class="empty-box">
    <text class="loading-title">{{query ? '没有找到相关知识' : '还没有知识内容'}}</text>
    <text class="loading-subtitle">{{query ? '换个关键词试试，或分享一条新的打印心得。' : '审核通过的知识投稿会显示在这里。'}}</text>
  </view>
</view>
