<view class="page detail-page" wx:if="{{detail}}">
  <view class="hero-card detail-hero">
    <image wx:if="{{(detail.heroThumbUrl || detail.image_url) && !heroImageFailed}}" class="detail-hero-image" src="{{detail.heroThumbUrl || detail.image_url}}" mode="aspectFill" lazy-load="true" binderror="onHeroImageError"></image>
    <view wx:else class="detail-hero-image detail-hero-image-fallback"></view>
    <text class="meta">TROUBLESHOOTING DETAIL</text>
    <view class="detail-title-row">
      <text class="title detail-title-text">{{detail.title}}</text>
      <view class="detail-reactions">
        <view class="detail-reaction up {{detail.liked ? 'active' : ''}}" catchtap="toggleProblemLike">
          <text class="detail-reaction-icon">👍</text>
          <text class="detail-reaction-count">{{detail.likeCount || 0}}</text>
        </view>
        <view class="detail-reaction down {{detail.disliked ? 'active' : ''}}" catchtap="toggleProblemDislike">
          <text class="detail-reaction-icon">👎</text>
          <text class="detail-reaction-count">{{detail.dislikeCount || 0}}</text>
        </view>
      </view>
    </view>
    <text class="subtitle">{{detail.subtitle}}</text>
    <view class="row" style="margin-top: 18rpx;">
      <view>
        <text class="badge">{{detail.category}}</text>
        <text wx:if="{{detail.estimatedTime}}" class="badge" style="margin-left: 12rpx;">{{detail.estimatedTime}}</text>
      </view>
      <view wx:if="{{detail.sourceType !== 'submission'}}" class="detail-fav-btn interactive-chip" hover-class="interactive-chip-hover" hover-stay-time="70" bindtap="toggleFavorite">
        <text>{{isFav ? '已收藏' : '收藏'}}</text>
      </view>
    </view>
  </view>

  <view class="panel detail-section">
    <view class="detail-section-head">
      <text class="detail-section-index">01</text>
      <view>
        <text class="title" style="font-size: 30rpx;">常见原因</text>
        <text class="subtitle detail-section-subtitle">先判断问题可能从哪里来</text>
      </view>
    </view>
    <view class="list detail-list">
      <view wx:for="{{detail.causes}}" wx:key="*this" class="cause-card">
        <text class="cause-dot"></text>
        <text class="subtitle cause-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="panel detail-section">
    <view class="detail-section-head">
      <text class="detail-section-index">02</text>
      <view>
        <text class="title" style="font-size: 30rpx;">解决步骤</text>
        <text class="subtitle detail-section-subtitle">建议按顺序逐项排查</text>
      </view>
    </view>
    <view class="list detail-list">
      <view wx:for="{{detail.solutions}}" wx:key="step" class="step-card">
        <view class="step-card-head" data-key="{{item.step}}" bindtap="toggleStep">
          <view class="step-number">{{item.step}}</view>
          <view class="step-copy">
            <text class="title step-title">{{item.title}}</text>
            <text class="subtitle step-status">{{expandedStepMap[item.step] ? '点击收起' : '点击展开查看步骤内容'}}</text>
          </view>
          <text class="step-toggle">{{expandedStepMap[item.step] ? '−' : '+'}}</text>
        </view>
        <view wx:if="{{expandedStepMap[item.step]}}" class="step-expanded">
          <text class="subtitle step-detail">{{item.detail}}</text>
          <image wx:if="{{item.imageThumbUrl}}" class="step-detail-image" src="{{item.imageThumbUrl}}" mode="aspectFill" lazy-load="true" data-url="{{item.imagePreviewUrl || item.image_url || item.imageThumbUrl}}" bindtap="previewStepImage"></image>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{detail.tips}}" class="panel detail-section">
    <view class="detail-section-head">
      <text class="detail-section-index">03</text>
      <view>
        <text class="title" style="font-size: 30rpx;">补充提醒</text>
        <text class="subtitle detail-section-subtitle">避免问题反复出现</text>
      </view>
    </view>
    <text class="subtitle tips-text">{{detail.tips}}</text>
  </view>

  <view wx:if="{{related.length || !relatedReady}}" class="panel">
    <text class="title" style="font-size: 30rpx;">相关问题</text>
    <view class="list" style="margin-top: 18rpx;">
      <view wx:for="{{related}}" wx:key="id" class="card interactive-card" hover-class="interactive-card-hover" hover-stay-time="70" data-id="{{item.id}}" bindtap="openRelated">
        <text class="title" style="font-size: 28rpx;">{{item.title}}</text>
        <text class="subtitle">{{item.subtitle}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:else class="page">
  <view class="empty-box">
    <text class="title" style="font-size: 34rpx;">没找到这个问题</text>
    <text class="subtitle">可能是这个问题还没有同步到小程序端。</text>
  </view>
</view>
