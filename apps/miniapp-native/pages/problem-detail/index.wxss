.detail-page {
  gap: 24rpx;
}

.detail-hero {
  overflow: hidden;
  border-radius: 30rpx;
  background: #ffffff;
}

.detail-hero-image {
  width: 100%;
  height: 330rpx;
  margin-bottom: 22rpx;
  border-radius: 26rpx;
  background: #eeeeee;
}

.detail-hero-image-fallback {
  background: linear-gradient(135deg, #e8f8e9 0%, #f4f4f4 100%);
}

.detail-hero .meta {
  color: #46b855;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.detail-title-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.detail-title-text {
  min-width: 0;
  flex: 1;
  line-height: 1.28;
}

.detail-reactions {
  min-width: 148rpx;
  height: 70rpx;
  border-radius: 999rpx;
  background: #f3f3f3;
  color: #8a8a8a;
  display: flex;
  flex-direction: row;
  overflow: hidden;
  flex-shrink: 0;
  box-sizing: border-box;
}

.detail-reaction {
  min-height: 0;
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #9a9a9a;
}

.detail-reaction + .detail-reaction {
  border-left: 1rpx solid #e5e5e5;
}

.detail-reaction.up.active {
  background: #eefbea;
  color: #46b855;
}

.detail-reaction.down.active {
  background: #fff4e8;
  color: #e58b2a;
}

.detail-reaction-icon {
  display: block;
  font-size: 28rpx;
  line-height: 1;
}

.detail-reaction-count {
  font-size: 22rpx;
  font-weight: 850;
  line-height: 1;
}

.detail-fav-btn {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #eefbea;
  color: #46b855;
  font-size: 24rpx;
  font-weight: 800;
}

.detail-fav-btn text {
  line-height: 1;
}

.interactive-card {
  transform: scale(1);
  transition: transform 0.16s ease, opacity 0.16s ease;
}

.interactive-card-hover {
  transform: scale(0.988);
  opacity: 0.95;
}

.interactive-chip {
  transform: scale(1);
  transition: transform 0.14s ease, opacity 0.14s ease;
}

.interactive-chip-hover {
  transform: scale(0.97);
  opacity: 0.92;
}

.detail-section {
  padding: 28rpx;
  border-radius: 30rpx;
}

.detail-section-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.detail-section-index {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #46b855;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.detail-section-subtitle {
  margin-top: 4rpx;
}

.detail-list {
  margin-top: 22rpx;
}

.cause-card {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eeeeee;
  background: #ffffff;
}

.cause-card:last-child {
  border-bottom: 0;
}

.cause-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 16rpx;
  border-radius: 50%;
  background: #46b855;
  flex-shrink: 0;
}

.cause-text {
  flex: 1;
  margin-top: 0;
}

.step-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: #f6f6f6;
}

.step-card-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.step-number {
  width: 58rpx;
  height: 58rpx;
  border-radius: 18rpx;
  background: #eefbea;
  color: #46b855;
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-copy {
  min-width: 0;
  flex: 1;
}

.step-title {
  font-size: 28rpx;
}

.step-status {
  margin-top: 6rpx;
  color: #8a8a8a;
  font-size: 22rpx;
}

.step-toggle {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #46b855;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 52rpx;
  text-align: center;
  flex-shrink: 0;
}

.step-expanded {
  margin-top: 18rpx;
  padding-left: 76rpx;
}

.step-detail {
  margin-top: 10rpx;
  color: #4b4f55;
}

.step-detail-image {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
  border-radius: 24rpx;
  background: #eeeeee;
  display: block;
}

.tips-text {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #eefbea;
  color: #315a36;
}
